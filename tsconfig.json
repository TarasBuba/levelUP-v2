{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "functions/**/*", "api/**/*", "tests/**/*", "e2e/**/*"],
  "exclude": ["dist", "node_modules"]
}
