---
import MainLayout from '../layouts/MainLayout.astro';
import LiveSlotsBadge from '../components/LiveSlotsBadge.astro';
import InstantCalculator from '../components/InstantCalculator.astro';
import ChecklistTabs from '../components/ChecklistTabs.astro';
import RoomXRay from '../components/RoomXRay.astro';
import FurrySupervisors from '../components/FurrySupervisors.astro';
import TrustProtocol from '../components/TrustProtocol.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

import siteContext from '../data/site_context_lock.json';
import siteCopy from '../data/site_copy.json';
import mediaManifest from '../data/media_manifest.json';
import type { PageSeoConfig } from '../types/contracts';

const { hero, walkthroughSteps, whyEdmontonCards, faqs } = siteCopy.home;
const moveOutSvc = siteCopy.services.move_out;
const heroPhoto = mediaManifest.photos.hero_kitchen;
const moveOutPhoto = mediaManifest.photos.moveout_condo;
const winterPhoto = mediaManifest.photos.winter_entryway;
const holidayPhoto = mediaManifest.photos.holiday_living;

const seoConfig: PageSeoConfig = {
  title: 'LevelUp Cleaning Edmonton | Eco House & Move-Out Cleaning ($0 Upfront)',
  description:
    'Quiet-luxury eco house & move-out cleaning in Edmonton, St. Albert & Sherwood Park from $120 CAD (+ 5% AB GST where applicable). Oven, fridge & cabinets included in Move-Out. $0 upfront deposit.',
  canonicalPath: '/',
  ogImage: heroPhoto.variants['1024'].webp.path,
  preloadHeroImage: heroPhoto.variants['1024'].avif.path,
  serviceSchema: {
    name: 'Eco-Friendly House & Move-Out Cleaning Edmonton',
    description:
      'Flat-rate and custom hourly residential cleaning across Greater Edmonton with 100% pet-safe botanical formulas and 50-point walkthrough sign-off.',
    lowPriceCad: 120,
    highPriceCad: 575,
  },
  faqs,
};

const serviceCards = [
  {
    data: siteCopy.services.move_out,
    photo: moveOutPhoto,
    highlight: 'Oven + Fridge + Cabinets FREE ($135 Value)',
  },
  {
    data: siteCopy.services.deep_clean,
    photo: heroPhoto,
    highlight: 'Baseboards, Hard-Water Glass & Trim',
  },
  {
    data: siteCopy.services.regular,
    photo: holidayPhoto,
    highlight: 'Save 15% Weekly • 10% Bi-Weekly',
  },
  {
    data: siteCopy.services.airbnb,
    photo: winterPhoto,
    highlight: '11am–3pm Window • SMS Ready Photos',
  },
];
---

<MainLayout seoConfig={seoConfig} ctaHref="#quote-calculator">
  <section class="surface-quiet-luxury relative overflow-hidden border-b border-mist/25 pt-8 pb-14 sm:pt-12 sm:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-6 space-y-6">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center rounded-full border border-mist/40 bg-card px-3.5 py-1.5 text-[11px] font-semibold tracking-wider uppercase text-spruce">
              {hero.eyebrow}
            </span>
            <LiveSlotsBadge compact />
          </div>

          <h1 class="font-serif text-4xl sm:text-5xl lg:text-[3.35rem] font-semibold leading-[1.08] text-spruce">
            {hero.h1}{' '}
            <span class="block text-eucalyptus mt-1">{hero.h1Accent}</span>
          </h1>

          <p class="text-base sm:text-lg leading-relaxed text-spruce/85">
            {hero.subtitle}
          </p>

          <form
            data-hero-postal-form
            novalidate
            class="rounded-2xl border border-mist/45 bg-card p-2 shadow-xs"
          >
            <label for="hero-postal-input" class="sr-only">
              Enter your Edmonton postal code to see price and open dates
            </label>
            <div class="flex flex-col sm:flex-row gap-2">
              <input
                id="hero-postal-input"
                type="text"
                inputmode="text"
                maxlength="7"
                autocomplete="postal-code"
                placeholder="Enter postal code (e.g. T5K, T6W, T8N)"
                data-hero-postal
                class="min-h-[48px] flex-1 rounded-xl border border-mist/35 bg-linen px-4 py-2.5 text-sm sm:text-base font-semibold uppercase tracking-wider text-spruce placeholder:font-normal placeholder:normal-case placeholder:tracking-normal placeholder:text-spruce/50 focus:border-eucalyptus"
              />
              <button
                type="submit"
                class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-xl bg-eucalyptus px-5 py-3 text-sm font-semibold text-linen shadow-xs transition hover:bg-eucalyptus-hover whitespace-nowrap cursor-pointer"
              >
                <span>See Price &amp; Open Dates</span>
                <span aria-hidden="true">→</span>
              </button>
            </div>
            <p data-hero-postal-note class="px-2 pt-1.5 text-[11px] font-medium text-spruce/75">
              $0 travel across all Edmonton (T5*/T6*), St. Albert (T8N) &amp; core Sherwood Park (T8A/T8H).
            </p>
          </form>

          <div class="flex flex-wrap items-center gap-3">
            <a
              href={`sms:${siteContext.brand.phoneE164}?&body=${encodeURIComponent("Hi LevelUp Cleaning! I'd like an instant quote for my Edmonton home.")}`}
              class="inline-flex min-h-[46px] items-center justify-center gap-2 rounded-full border border-spruce/30 bg-card px-5 py-2.5 text-sm font-semibold text-spruce transition hover:border-eucalyptus"
            >
              <span>{hero.secondaryCta}</span>
            </a>
            <a
              href="/pricing"
              class="inline-flex min-h-[46px] items-center justify-center rounded-full px-4 py-2.5 text-sm font-semibold text-eucalyptus underline decoration-eucalyptus/45 underline-offset-4 hover:text-eucalyptus-hover"
            >
              View Full Pre-Tax CAD Rates →
            </a>
          </div>

          <div class="flex flex-wrap gap-2 pt-1">
            {hero.microBadges.map((badge) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-mist/35 bg-card/90 px-3 py-1 text-xs font-medium text-spruce">
                <span class="text-eucalyptus font-bold" aria-hidden="true">✓</span>
                <span>{badge}</span>
              </span>
            ))}
          </div>

          <div class="space-y-1 border-t border-mist/25 pt-4 text-xs text-spruce/75">
            <p class="font-semibold text-spruce/90">{hero.trustLine}</p>
            <p>{hero.taxNote}</p>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="relative overflow-hidden rounded-3xl border border-mist/35 bg-card shadow-xl">
            <picture>
              <source
                type="image/avif"
                srcset={heroPhoto.srcset.avif}
                sizes="(min-width: 1024px) 50vw, 100vw"
              />
              <source
                type="image/webp"
                srcset={heroPhoto.srcset.webp}
                sizes="(min-width: 1024px) 50vw, 100vw"
              />
              <img
                src={heroPhoto.fallback.path}
                alt={heroPhoto.alt}
                width="1440"
                height="810"
                fetchpriority="high"
                class="aspect-video w-full object-cover"
              />
            </picture>

            <div class="border-t border-mist/25 bg-card/95 px-5 py-3.5 flex flex-wrap items-center justify-between gap-3 text-xs">
              <div class="flex items-center gap-2 font-semibold text-spruce">
                <span class="h-2 w-2 rounded-full bg-eucalyptus" aria-hidden="true"></span>
                <span>pH-Neutral Quartz, Stone, Hardwood &amp; Matte-Black Safe</span>
              </div>
              <button
                type="button"
                data-open-receipt-modal
                class="inline-flex min-h-[44px] items-center font-semibold text-eucalyptus underline decoration-eucalyptus/50 underline-offset-4 hover:text-eucalyptus-hover cursor-pointer"
              >
                Sample Landlord Receipt →
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-brass/45 bg-brass/15 px-3.5 py-1 text-xs font-semibold tracking-wider uppercase text-spruce">
            Transparent Pre-Tax CAD Packages
          </span>
          <h2 class="mt-3 font-serif text-3xl sm:text-4xl font-semibold text-spruce">
            Tailored Cleaning Built Around Edmonton Homes
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-spruce/75">
          Compare all packages on our <a href="/pricing" class="font-semibold text-eucalyptus underline">Pricing page</a> or choose <a href="#quote-calculator" class="font-semibold text-eucalyptus underline">Hourly Custom Clean ($48/hr)</a>.
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {serviceCards.map(({ data, photo, highlight }) => (
          <article class="group flex flex-col overflow-hidden rounded-3xl border border-mist/35 bg-card shadow-2xs transition hover:border-eucalyptus hover:shadow-md">
            <div class="aspect-[4/3] w-full overflow-hidden bg-spruce/10">
              <picture>
                <source type="image/avif" srcset={photo.srcset.avif} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" />
                <source type="image/webp" srcset={photo.srcset.webp} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" />
                <img
                  src={photo.fallback.path}
                  alt={photo.alt}
                  width={photo.variants['640'].width}
                  height={photo.variants['640'].height}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </picture>
            </div>

            <div class="flex flex-1 flex-col justify-between p-5 space-y-4">
              <div class="space-y-2">
                <span class="inline-block rounded-full border border-brass/45 bg-brass/15 px-2.5 py-0.5 text-[11px] font-semibold text-spruce">
                  {highlight}
                </span>
                <h3 class="font-serif text-xl font-semibold leading-snug text-spruce">
                  {data.h1}
                </h3>
                <p class="text-xs sm:text-sm leading-relaxed text-spruce/80 line-clamp-3">
                  {data.subtitle}
                </p>
              </div>

              <div class="border-t border-mist/25 pt-3.5 space-y-3">
                <div>
                  <p class="font-serif text-2xl font-semibold text-spruce">
                    From ${data.startingPriceCad}{' '}
                    <span class="font-sans text-xs font-normal text-spruce/75">CAD pre-tax</span>
                  </p>
                  <p class="text-[11px] text-spruce/70">+ 5% AB GST where applicable</p>
                </div>

                <a
                  href={data.routePath}
                  class="inline-flex min-h-[44px] w-full items-center justify-center rounded-full border border-spruce/25 bg-linen px-4 py-2 text-xs font-semibold text-spruce transition group-hover:border-eucalyptus group-hover:bg-eucalyptus group-hover:text-linen"
                >
                  View Full 50-Point Scope →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="border-y border-mist/25 bg-card/45">
    <InstantCalculator
      defaultService="move_out"
      defaultBedrooms={2}
      defaultBathrooms={2}
      defaultFrequency="one_time"
    />
  </div>

  <RoomXRay />

  <div class="border-t border-mist/25 bg-linen">
    <ChecklistTabs
      eyebrow="50-POINT MOVE-OUT & DEEP RESET TRANSPARENCY"
      title="Exact Room-by-Room Scope — Oven, Fridge & Cabinets Included"
      subtitle="Inspect every task covered in our Alberta RTA Move-Out Clean, or explore all 4 service checklists on our dedicated Checklist page."
      checklistByRoom={moveOutSvc.checklistByRoom}
      whatIsExcluded={moveOutSvc.whatIsExcluded}
    />
    <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8 flex justify-end">
      <a
        href="/checklist"
        class="inline-flex min-h-[44px] items-center text-sm font-semibold text-eucalyptus underline decoration-eucalyptus/50 underline-offset-4 hover:text-eucalyptus-hover"
      >
        Compare All 4 Package Checklists →
      </a>
    </div>
  </div>

  <section class="py-12 sm:py-14 bg-spruce text-linen border-y border-mist/25">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl space-y-2.5">
          <span class="inline-flex items-center gap-2 rounded-full border border-brass/55 bg-brass/18 px-3 py-1 text-[11px] font-semibold tracking-wider uppercase text-linen">
            <span class="h-1.5 w-1.5 rounded-full bg-brass" aria-hidden="true"></span>
            VIP Commercial &amp; Portfolio Desk
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-linen">
            Airbnb Superhosts, Realtors &amp; Property Managers
          </h2>
          <p class="text-sm sm:text-base leading-relaxed text-linen/85">
            Priority 11:00 AM – 3:00 PM same-day turnovers, lockbox/concierge coordination, timestamped SMS photo reports, and recurring volume savings up to 15% across Greater Edmonton.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href="/airbnb-cleaning-edmonton#partner-inquiry"
            class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-eucalyptus px-6 py-3 text-sm font-semibold text-linen shadow-xs transition hover:bg-eucalyptus-hover"
          >
            Request VIP Partner Rates →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 border-b border-mist/25 bg-card/55">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-16">
      <div>
        <div class="max-w-3xl">
          <span class="inline-flex items-center gap-2 rounded-full border border-brass/45 bg-brass/15 px-3.5 py-1 text-xs font-semibold tracking-wider uppercase text-spruce">
            Built for 53° North
          </span>
          <h2 class="mt-3 font-serif text-3xl sm:text-4xl font-semibold text-spruce">
            Engineered for Edmonton Water, Winters &amp; RTA Inspections
          </h2>
        </div>

        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {whyEdmontonCards.map((card) => (
            <article class="flex flex-col justify-between rounded-3xl border border-mist/35 bg-linen p-6 shadow-2xs">
              <div class="space-y-3">
                <span class="inline-block rounded-full border border-brass/45 bg-brass/15 px-3 py-1 text-[11px] font-semibold tracking-wider uppercase text-spruce">
                  {card.badge}
                </span>
                <h3 class="font-serif text-xl font-semibold text-spruce">{card.title}</h3>
                <p class="text-sm leading-relaxed text-spruce/80">{card.body}</p>
              </div>
              <p class="mt-5 border-t border-mist/25 pt-3 text-xs font-bold text-eucalyptus">
                {card.highlightStat}
              </p>
            </article>
          ))}
        </div>
      </div>

      <div>
        <h3 class="font-serif text-2xl sm:text-3xl font-semibold text-spruce">
          How Your Calm, $0-Upfront Visit Works
        </h3>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {walkthroughSteps.map((s) => (
            <div class="rounded-2xl border border-mist/30 bg-linen p-5 space-y-2">
              <span class="font-mono text-xs font-bold uppercase tracking-widest text-eucalyptus">
                Step {s.step}
              </span>
              <h4 class="font-serif text-lg font-semibold text-spruce">{s.title}</h4>
              <p class="text-sm leading-relaxed text-spruce/80">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <FurrySupervisors />

  <TrustProtocol showComparison={true} includeModal={true} />

  <section class="py-16 sm:py-20 border-b border-mist/25">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-14">
      <div>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-eucalyptus">
              Local Dispatch Coverage
            </span>
            <h2 class="mt-1 font-serif text-3xl font-semibold text-spruce">
              Greater Edmonton Neighbourhood Hubs ($0 Core Travel)
            </h2>
          </div>
          <a
            href="/gift-a-clean"
            class="inline-flex min-h-[44px] items-center text-sm font-semibold text-eucalyptus underline decoration-eucalyptus/50 underline-offset-4"
          >
            Explore December Gift Certificates →
          </a>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {siteCopy.areaHubs.map((hub) => (
            <a
              href={`/areas/${hub.slug}`}
              class="group flex flex-col justify-between rounded-2xl border border-mist/35 bg-card p-5 transition hover:border-eucalyptus hover:shadow-sm"
            >
              <div>
                <p class="text-xs font-mono font-semibold text-eucalyptus">
                  {hub.fsaCodes.slice(0, 5).join(' • ')}
                </p>
                <h3 class="mt-2 font-serif text-lg font-semibold text-spruce group-hover:text-eucalyptus">
                  {hub.title}
                </h3>
                <p class="mt-2 text-xs leading-relaxed text-spruce/80 line-clamp-3">
                  {hub.neighborhoods.join(', ')}
                </p>
              </div>
              <span class="mt-4 inline-flex min-h-[36px] items-center text-xs font-semibold text-spruce group-hover:text-eucalyptus">
                Local Pricing &amp; Access Notes →
              </span>
            </a>
          ))}
        </div>
      </div>

      <div>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-eucalyptus">
              Edmonton Homeowner &amp; Renter Library
            </span>
            <h2 class="mt-1 font-serif text-2xl sm:text-3xl font-semibold text-spruce">
              Surface Chemistry &amp; Alberta Move-Out Guides
            </h2>
          </div>
          <a
            href="/guides"
            class="inline-flex min-h-[44px] items-center text-sm font-semibold text-eucalyptus underline decoration-eucalyptus/50 underline-offset-4"
          >
            Read All 4 Guides →
          </a>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {siteCopy.guides.map((guide) => (
            <a
              href={`/guides/${guide.slug}`}
              class="group flex flex-col justify-between rounded-2xl border border-mist/35 bg-card p-5 transition hover:border-eucalyptus"
            >
              <div>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-spruce/70">
                  {guide.category} • {guide.readTimeMinutes} min
                </span>
                <h3 class="mt-2 font-serif text-base font-semibold leading-snug text-spruce group-hover:text-eucalyptus">
                  {guide.title}
                </h3>
              </div>
              <span class="mt-4 text-xs font-semibold text-eucalyptus">Read Guide →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <FaqAccordion faqs={faqs} />
</MainLayout>

<script>
  const heroForm = document.querySelector<HTMLFormElement>('[data-hero-postal-form]');
  if (heroForm) {
    const input = heroForm.querySelector<HTMLInputElement>('[data-hero-postal]');
    heroForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const postalCode = (input?.value || '').trim().toUpperCase();
      window.dispatchEvent(
        new CustomEvent('levelup:hero-postal', {
          detail: { postalCode },
        }),
      );
    });
  }
</script>
