---
import MainLayout from '../layouts/MainLayout.astro';
import LiveSlotsBadge from '../components/LiveSlotsBadge.astro';
import InstantCalculator from '../components/InstantCalculator.astro';
import TrustProtocol from '../components/TrustProtocol.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

import strategy from '../data/strategy.json';
import siteCopy from '../data/site_copy.json';
import mediaManifest from '../data/media_manifest.json';
import type { PageSeoConfig } from '../types/contracts';

const { packages, hourly, addons, extraBathroomFeeCad, taxDisplayNote } = strategy.pricing;
const heroPhoto = mediaManifest.photos.hero_kitchen;

const packageRows = [
  {
    key: 'move_out',
    title: packages.move_out.title,
    badge: 'Oven + Fridge + Cabinets Included ($135 Value)',
    href: '/move-out-cleaning-edmonton',
    beds: packages.move_out.baseByBedrooms,
  },
  {
    key: 'deep_clean',
    title: packages.deep_clean.title,
    badge: '50-Point Baseboards, Hard-Water & Salt Reset',
    href: '/deep-cleaning-edmonton',
    beds: packages.deep_clean.baseByBedrooms,
  },
  {
    key: 'regular',
    title: packages.regular.title,
    badge: 'Save 5% Monthly • 10% Bi-Weekly • 15% Weekly',
    href: '/recurring-cleaning-edmonton',
    beds: packages.regular.baseByBedrooms,
  },
  {
    key: 'airbnb',
    title: packages.airbnb.title,
    badge: '11am–3pm Same-Day Window • SMS Photo Proof',
    href: '/airbnb-cleaning-edmonton',
    beds: packages.airbnb.baseByBedrooms,
  },
];

const addonRows = Object.entries(addons).map(([id, cfg]) => ({
  id,
  label: cfg.label,
  priceCad: cfg.priceCad,
  moveOutIncluded: ['inside_oven', 'inside_fridge', 'inside_cabinets'].includes(id),
}));

const travelZones = [
  {
    zone: 'Edmonton Core & Suburbs (All T5* & T6* FSAs)',
    communities: 'Downtown, Ice District, Oliver/Wîhkwêntôwin, Whyte Ave, Garneau, Glenora, Crestwood, Windermere, Keswick, Terwillegar, Riverbend, Summerside, Griesbach',
    fee: '$0 CAD',
    highlight: true,
  },
  {
    zone: 'St. Albert (T8N) & Core Sherwood Park (T8A, T8H)',
    communities: 'City of St. Albert, Sherwood Park West, Central & Emerald Hills',
    fee: '$0 CAD',
    highlight: true,
  },
  {
    zone: 'Greater Edmonton Metro Ring',
    communities: 'Spruce Grove (T7X/T7Y), Stony Plain (T7Z), Leduc & Nisku (T9E), Beaumont (T4X), Fort Saskatchewan (T8L), Devon (T9G), Rural Strathcona County (T8B/T8C/T8E/T8G)',
    fee: '+$15 CAD',
    highlight: false,
  },
];

const pricingFaqs = siteCopy.home.faqs.slice(0, 6);

const seoConfig: PageSeoConfig = {
  title: 'House Cleaning Prices Edmonton (2026) | Transparent Pre-Tax CAD Rates | LevelUp',
  description:
    'Transparent flat-rate and $48/hr house cleaning prices in Edmonton, St. Albert & Sherwood Park. Move-Out from $235 (oven, fridge & cabinets included), Deep Clean from $210, Recurring from $130 CAD pre-tax.',
  canonicalPath: '/pricing',
  ogImage: heroPhoto.variants['1024'].webp.path,
  preloadHeroImage: heroPhoto.variants['1024'].avif.path,
  offerCatalogSchema: {
    name: 'LevelUp Cleaning Edmonton Pre-Tax CAD Pricing Catalog',
    description:
      'Flat-rate packages (1–5 bedrooms) and $48/hr custom eco-friendly cleaning across Greater Edmonton (+ 5% AB GST where applicable).',
    items: [
      {
        name: 'Move-Out / Move-In Inspection Clean (1-Bed Starting)',
        description: 'Includes Inside Oven, Inside Fridge, Inside Cabinets ($135 value) and itemized Alberta RTA landlord receipt.',
        priceCad: 235,
        urlPath: '/move-out-cleaning-edmonton',
      },
      {
        name: 'The LevelUp 50-Point Deep Reset (1-Bed Starting)',
        description: 'Top-to-bottom baseboards, EPCOR hard-water glass, winter road salt and furnace dust reset.',
        priceCad: 210,
        urlPath: '/deep-cleaning-edmonton',
      },
      {
        name: 'Recurring Eco-Maintenance (1-Bed Starting)',
        description: 'Weekly (-15%), Bi-Weekly (-10%), or Monthly (-5%) pet-safe botanical home maintenance.',
        priceCad: 130,
        urlPath: '/recurring-cleaning-edmonton',
      },
      {
        name: 'Airbnb & Short-Term 5-Star Turnover (1-Bed Starting)',
        description: 'Same-day 11am–3pm check-in staging with timestamped SMS photo verification.',
        priceCad: 120,
        urlPath: '/airbnb-cleaning-edmonton',
      },
      {
        name: 'Hourly Custom Clean (Per Specialist, 3-Hr Minimum)',
        description: 'Priority-room eco cleaning at $48/hr per specialist with HEPA filtration and botanical kits.',
        priceCad: 48,
        urlPath: '/pricing',
      },
    ],
  },
  faqs: pricingFaqs,
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Edmonton Cleaning Prices', path: '/pricing' },
  ],
};
---

<MainLayout seoConfig={seoConfig} ctaHref="#quote-calculator">
  <section class="surface-quiet-luxury border-b border-mist/25 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="inline-flex items-center rounded-full border border-brass/50 bg-brass/18 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-spruce">
            2026 Transparent Rate Sheet • Edmonton, AB
          </span>
          <LiveSlotsBadge compact />
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl font-semibold leading-tight text-spruce">
          Transparent Edmonton House Cleaning Prices
        </h1>

        <p class="text-base sm:text-lg leading-relaxed text-spruce/85">
          Zero phone-quote guesswork and zero hidden eco upcharges. Every rate below is shown in clear pre-tax Canadian dollars ({taxDisplayNote}) with $0 upfront deposit until walkthrough sign-off.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="#quote-calculator"
            class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-eucalyptus px-6 py-3 text-sm font-semibold text-linen shadow-xs transition hover:bg-eucalyptus-hover"
          >
            Calculate My Exact Quote →
          </a>
          <a
            href="/checklist"
            class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-spruce/30 bg-card px-5 py-3 text-sm font-semibold text-spruce transition hover:border-eucalyptus"
          >
            See 50-Point Scope Checklist
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-18">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-12">
      <div>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-eucalyptus">
              Flat-Rate Package Matrix (1 to 5 Bedrooms)
            </span>
            <h2 class="mt-1 font-serif text-3xl font-semibold text-spruce">
              All 4 Core Packages in Pre-Tax CAD
            </h2>
          </div>
          <p class="text-xs font-semibold text-spruce/75">
            1st bathroom included • +${extraBathroomFeeCad} CAD per extra bathroom • {taxDisplayNote}
          </p>
        </div>

        <div class="mt-6 grid gap-4 md:hidden">
          {packageRows.map((pkg) => (
            <article class="rounded-2xl border border-mist/35 bg-card p-5 space-y-3">
              <div>
                <h3 class="font-serif text-xl font-semibold text-spruce">{pkg.title}</h3>
                <p class="mt-0.5 text-xs font-semibold text-eucalyptus">{pkg.badge}</p>
              </div>
              <div class="grid grid-cols-5 gap-1.5 text-center text-xs">
                {(['1', '2', '3', '4', '5'] as const).map((bed) => (
                  <div class="rounded-xl border border-mist/30 bg-linen p-2">
                    <span class="block text-[10px] font-semibold text-spruce/70">{bed} BD</span>
                    <span class="mt-0.5 block font-bold text-spruce">${pkg.beds[bed]}</span>
                  </div>
                ))}
              </div>
              <a
                href={pkg.href}
                class="inline-flex min-h-[44px] w-full items-center justify-center rounded-full border border-spruce/25 bg-linen px-4 py-2 text-xs font-semibold text-spruce hover:border-eucalyptus"
              >
                View Full Scope →
              </a>
            </article>
          ))}
        </div>

        <div class="mt-6 hidden md:block overflow-x-auto rounded-3xl border border-mist/35 bg-card shadow-xs">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-spruce text-linen">
                <th scope="col" class="py-4 px-5 font-serif font-semibold">Package</th>
                <th scope="col" class="py-4 px-4 font-mono text-xs uppercase text-center">1 Bed</th>
                <th scope="col" class="py-4 px-4 font-mono text-xs uppercase text-center">2 Bed</th>
                <th scope="col" class="py-4 px-4 font-mono text-xs uppercase text-center">3 Bed</th>
                <th scope="col" class="py-4 px-4 font-mono text-xs uppercase text-center">4 Bed</th>
                <th scope="col" class="py-4 px-4 font-mono text-xs uppercase text-center">5 Bed</th>
                <th scope="col" class="py-4 px-5 text-right font-serif font-semibold">Scope</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-mist/25 bg-linen">
              {packageRows.map((pkg) => (
                <tr class="hover:bg-card/60">
                  <th scope="row" class="py-4 px-5">
                    <span class="block font-serif text-base font-semibold text-spruce">{pkg.title}</span>
                    <span class="block text-xs font-medium text-eucalyptus mt-0.5">{pkg.badge}</span>
                  </th>
                  <td class="py-4 px-4 text-center font-semibold text-spruce">${pkg.beds['1']}</td>
                  <td class="py-4 px-4 text-center font-semibold text-spruce">${pkg.beds['2']}</td>
                  <td class="py-4 px-4 text-center font-semibold text-spruce">${pkg.beds['3']}</td>
                  <td class="py-4 px-4 text-center font-semibold text-spruce">${pkg.beds['4']}</td>
                  <td class="py-4 px-4 text-center font-semibold text-spruce">${pkg.beds['5']}</td>
                  <td class="py-4 px-5 text-right">
                    <a
                      href={pkg.href}
                      class="inline-flex min-h-[40px] items-center text-xs font-semibold text-eucalyptus underline underline-offset-4 hover:text-eucalyptus-hover"
                    >
                      Details →
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-3xl border border-mist/35 bg-card p-6 space-y-3">
          <span class="inline-block rounded-full border border-eucalyptus/35 bg-eucalyptus/12 px-3 py-1 text-xs font-semibold text-eucalyptus">
            Below $50/hr Edmonton Median
          </span>
          <h3 class="font-serif text-2xl font-semibold text-spruce">
            Hourly Custom Clean: ${hourly.ratePerCleanerCad}/hr
          </h3>
          <p class="text-sm leading-relaxed text-spruce/80">
            Book {hourly.minHours}–{hourly.maxHours} hours with {hourly.minCleaners}–{hourly.maxCleaners} vetted specialists at <strong>${hourly.ratePerCleanerCad} CAD/hr per cleaner</strong> ({taxDisplayNote}). Ideal for priority-room resets, kitchens &amp; mudrooms, or post-party tidying.
          </p>
        </div>

        <div class="rounded-3xl border border-mist/35 bg-card p-6 space-y-3">
          <span class="inline-block rounded-full border border-brass/50 bg-brass/18 px-3 py-1 text-xs font-semibold text-spruce">
            Zero Lock-In Contracts
          </span>
          <h3 class="font-serif text-2xl font-semibold text-spruce">
            Recurring Loyalty Savings
          </h3>
          <ul class="space-y-2 text-sm text-spruce/85">
            <li class="flex items-center justify-between border-b border-mist/25 pb-1.5">
              <span>Monthly Eco-Maintenance</span>
              <strong class="text-eucalyptus">−5% OFF</strong>
            </li>
            <li class="flex items-center justify-between border-b border-mist/25 pb-1.5">
              <span>Bi-Weekly Eco-Maintenance</span>
              <strong class="text-eucalyptus">−10% OFF</strong>
            </li>
            <li class="flex items-center justify-between">
              <span>Weekly Eco-Maintenance</span>
              <strong class="text-eucalyptus">−15% OFF</strong>
            </li>
          </ul>
        </div>

        <div class="rounded-3xl border border-eucalyptus/40 bg-spruce p-6 text-linen space-y-3">
          <span class="inline-block rounded-full border border-brass/55 bg-brass/20 px-3 py-1 text-xs font-semibold text-linen">
            Move-Out Value Advantage
          </span>
          <h3 class="font-serif text-2xl font-semibold text-linen">
            $135 Appliance Bundle Included FREE
          </h3>
          <p class="text-sm leading-relaxed text-linen/85">
            Every Move-Out / Move-In Clean includes Inside Oven ($45), Inside Fridge ($45), and Inside Kitchen &amp; Bath Cabinets ($45) at $0 extra—plus an itemized Alberta RTA landlord receipt.
          </p>
        </div>
      </div>

      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-6 rounded-3xl border border-mist/35 bg-card p-6 sm:p-7 space-y-4">
          <h3 class="font-serif text-2xl font-semibold text-spruce">
            Precision Add-Ons (Pre-Tax CAD)
          </h3>
          <ul class="divide-y divide-mist/25 text-sm">
            {addonRows.map((item) => (
              <li class="flex items-center justify-between gap-3 py-3">
                <div>
                  <span class="font-medium text-spruce">{item.label}</span>
                  {item.moveOutIncluded && (
                    <span class="block text-[11px] font-semibold text-eucalyptus">
                      Included FREE in Move-Out packages
                    </span>
                  )}
                </div>
                <span class="shrink-0 font-mono font-semibold text-spruce">+${item.priceCad}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:col-span-6 rounded-3xl border border-mist/35 bg-card p-6 sm:p-7 space-y-4">
          <h3 class="font-serif text-2xl font-semibold text-spruce">
            Greater Edmonton Travel Zone Table
          </h3>
          <div class="space-y-3">
            {travelZones.map((tz) => (
              <div class="rounded-2xl border border-mist/30 bg-linen p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div>
                  <p class="text-sm font-semibold text-spruce">{tz.zone}</p>
                  <p class="mt-0.5 text-xs leading-relaxed text-spruce/75">{tz.communities}</p>
                </div>
                <span
                  class:list={[
                    'shrink-0 self-start sm:self-center rounded-full px-3 py-1 text-xs font-bold',
                    tz.highlight
                      ? 'bg-eucalyptus text-linen'
                      : 'border border-brass/50 bg-brass/20 text-spruce',
                  ]}
                >
                  {tz.fee}
                </span>
              </div>
            ))}
          </div>
          <p class="text-xs text-spruce/75">
            All headline prices are pre-tax CAD ({taxDisplayNote}). Minimum order floor: $95 CAD.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="border-y border-mist/25 bg-card/45">
    <InstantCalculator
      defaultService="move_out"
      defaultBedrooms={2}
      defaultBathrooms={2}
      defaultFrequency="one_time"
    />
  </div>

  <TrustProtocol showComparison={true} includeModal={true} />

  <FaqAccordion
    eyebrow="PRICING & BILLING FAQS"
    title="Straightforward Edmonton Pricing Answers"
    faqs={pricingFaqs}
  />
</MainLayout>
