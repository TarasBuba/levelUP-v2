---
import MainLayout from '../../layouts/MainLayout.astro';
import siteCopy from '../../data/site_copy.json';
import mediaManifest from '../../data/media_manifest.json';
import type { PageSeoConfig } from '../../types/contracts';

const guides = siteCopy.guides;

const seoConfig: PageSeoConfig = {
  title: 'Edmonton Home Care, Surface Chemistry & Move-Out Guides | LevelUp Cleaning',
  description:
    'Practical Edmonton guides on Alberta RTA move-out inspections, winter road salt floor care, EPCOR hard-water matte-black fixture safety, and oven self-clean risks.',
  canonicalPath: '/guides',
  ogImage: mediaManifest.photos.winter_entryway.variants['1024'].webp.path,
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'Edmonton Care Guides', path: '/guides' },
  ],
};
---

<MainLayout seoConfig={seoConfig} ctaHref="/#quote-calculator">
  <section class="surface-quiet-luxury border-b border-mist/25 py-12 sm:py-18">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <span class="inline-flex items-center gap-2 rounded-full border border-brass/45 bg-brass/15 px-3.5 py-1 text-xs font-semibold tracking-wider uppercase text-spruce">
          Edmonton Surface Chemistry &amp; RTA Library
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-spruce">
          Practical Care Guides for Edmonton Homes &amp; Renters
        </h1>
        <p class="text-base sm:text-lg leading-relaxed text-spruce/85">
          Research-backed protocols for North Saskatchewan River hard water, Alberta winter road salt, delicate natural stone and matte-black hardware, and stress-free Alberta RTA move-out inspections.
        </p>
      </div>

      <!-- Universal Surface Safety Reminder -->
      <div
        role="note"
        class="mt-8 rounded-2xl border border-brass bg-brass/18 p-4 sm:p-5 text-xs sm:text-sm leading-relaxed text-spruce"
      >
        <strong class="font-bold">LevelUp Surface-Safety Standard:</strong> Any DIY tip mentioning vinegar, citric acid, baking soda, or descaling is safe ONLY on sealed ceramic/porcelain tile or chrome mesh; NEVER use vinegar or acids on marble, travertine, natural stone, quartz, hardwood, unsealed grout, or matte-black/brass fixtures; always spot-test an inconspicuous area first.
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        {guides.map((guide, index) => (
          <article class="group flex flex-col overflow-hidden rounded-3xl border border-mist/35 bg-card shadow-2xs transition hover:border-eucalyptus hover:shadow-md">
            <a href={`/guides/${guide.slug}`} class="block aspect-[16/10] w-full overflow-hidden bg-spruce/10">
              <img
                src={guide.heroImage}
                alt={guide.title}
                width="1024"
                height="675"
                loading={index < 2 ? undefined : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </a>

            <div class="flex flex-1 flex-col justify-between p-6 sm:p-8 space-y-5">
              <div class="space-y-3">
                <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-spruce/75">
                  <span class="rounded-full border border-brass/45 bg-brass/15 px-3 py-0.5 text-spruce">
                    {guide.category}
                  </span>
                  <span>•</span>
                  <span>{guide.readTimeMinutes} min read</span>
                  <span>•</span>
                  <time datetime={guide.publishedDate}>{guide.publishedDate}</time>
                </div>

                <h2 class="font-serif text-2xl font-semibold leading-snug text-spruce group-hover:text-eucalyptus">
                  <a href={`/guides/${guide.slug}`}>{guide.title}</a>
                </h2>

                <p class="text-sm sm:text-base leading-relaxed text-spruce/80">
                  {guide.summary}
                </p>
              </div>

              <div class="border-t border-mist/25 pt-4 flex items-center justify-between">
                <a
                  href={`/guides/${guide.slug}`}
                  class="inline-flex min-h-[44px] items-center gap-1.5 text-sm font-semibold text-eucalyptus hover:text-eucalyptus-hover"
                >
                  <span>Read Full Protocol</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Bottom Booking Banner -->
      <div class="mt-14 rounded-3xl bg-spruce p-7 sm:p-10 text-linen flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-xl space-y-2">
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-linen">
            Rather Hand the Checklist to Our Edmonton Specialists?
          </h2>
          <p class="text-sm text-linen/85">
            Get an instant flat-rate CAD quote in 45 seconds—with pH-neutral surface-safe botanicals and $0 upfront deposit.
          </p>
        </div>
        <a
          href="/#quote-calculator"
          class="inline-flex min-h-[48px] shrink-0 items-center justify-center rounded-full bg-eucalyptus px-6 py-3 text-sm font-semibold text-linen transition hover:bg-eucalyptus-hover"
        >
          Calculate Instant Price →
        </a>
      </div>
    </div>
  </section>
</MainLayout>
