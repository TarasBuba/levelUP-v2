---
import siteContext from '../data/site_context_lock.json';

interface Props {
  ctaHref?: string;
}

const { ctaHref = '#quote-calculator' } = Astro.props;
const { brand } = siteContext;
const defaultSmsHref = `sms:${brand.phoneE164}?&body=${encodeURIComponent(
  "Hi LevelUp Cleaning! I'd like a quote for my Edmonton home."
)}`;
---

<div
  aria-label="Quick mobile booking actions"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-mist/35 bg-linen/95 px-3 py-2.5 backdrop-blur-md shadow-[0_-6px_24px_rgba(23,42,34,0.1)] lg:hidden"
>
  <div class="mx-auto grid max-w-lg grid-cols-2 gap-2.5">
    <a
      href={defaultSmsHref}
      data-sticky-sms
      class="inline-flex min-h-[46px] items-center justify-center gap-2 rounded-full border border-spruce/25 bg-card px-4 py-2.5 text-sm font-semibold text-spruce transition hover:border-eucalyptus"
    >
      <svg class="h-4 w-4 text-eucalyptus shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      <span>Text Us</span>
    </a>
    <a
      href={ctaHref}
      class="inline-flex min-h-[46px] items-center justify-center gap-1.5 rounded-full bg-eucalyptus px-4 py-2.5 text-sm font-semibold text-linen shadow-xs transition hover:bg-eucalyptus-hover"
    >
      <span>Instant Price</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>
