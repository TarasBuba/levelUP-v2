---
import type { ServiceId } from '../types/contracts';

interface Props {
  initialMode?: 'flat_rate' | 'hourly';
  initialService?: ServiceId;
  initialBedrooms?: number;
  initialHours?: number;
}

const {
  initialMode = 'flat_rate',
  initialService = 'move_out',
  initialBedrooms = 2,
  initialHours = 4,
} = Astro.props;

function buildInitialDays(count: number) {
  const now = new Date();
  const ymdFmt = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Edmonton',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
  const wdFmt = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Edmonton',
    weekday: 'short',
  });
  const monthFmt = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Edmonton',
    month: 'long',
    year: 'numeric',
  });

  const baseParts = ymdFmt.formatToParts(now);
  const y = Number(baseParts.find((p) => p.type === 'year')?.value || '2026');
  const m = Number(baseParts.find((p) => p.type === 'month')?.value || '11');
  const d = Number(baseParts.find((p) => p.type === 'day')?.value || '28');

  const days = [];
  for (let i = 1; i <= count; i++) {
    const dt = new Date(Date.UTC(y, m - 1, d + i, 18, 0, 0));
    const dateStr = ymdFmt.format(dt);
    const dayNum = Number(dateStr.slice(8, 10));
    days.push({
      date: dateStr,
      dayNum,
      weekdayShort: wdFmt.format(dt),
      monthLabel: monthFmt.format(dt),
    });
  }
  return days;
}

const ssrDays = buildInitialDays(14);
const initialMonthLabel = ssrDays[0]?.monthLabel || 'Edmonton Live Availability';
---

<div
  data-booking-calendar
  data-init-mode={initialMode}
  data-init-service={initialService}
  data-init-bedrooms={String(initialBedrooms)}
  data-init-hours={String(initialHours)}
  class="rounded-2xl border border-mist/45 bg-linen p-4 sm:p-5 space-y-4"
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-eucalyptus">
        Real-Time Edmonton Dispatch Calendar
      </p>
      <p data-cal-month class="font-serif text-base sm:text-lg font-semibold text-spruce">
        {initialMonthLabel}
      </p>
    </div>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        data-cal-prev
        disabled
        aria-label="Previous two weeks"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-mist/40 bg-card px-3 text-xs font-semibold text-spruce transition hover:border-eucalyptus disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
      >
        ← Prev
      </button>
      <button
        type="button"
        data-cal-next
        aria-label="Next two weeks"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-mist/40 bg-card px-3 text-xs font-semibold text-spruce transition hover:border-eucalyptus disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
      >
        Next →
      </button>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[11px] font-medium text-spruce/80">
    <span class="inline-flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-eucalyptus" aria-hidden="true"></span>
      <span>Available</span>
    </span>
    <span class="inline-flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-brass" aria-hidden="true"></span>
      <span>1 Window Left</span>
    </span>
    <span class="inline-flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-amber-600" aria-hidden="true"></span>
      <span>Pending</span>
    </span>
    <span class="inline-flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-rose-700" aria-hidden="true"></span>
      <span>Booked</span>
    </span>
  </div>

  <div
    data-cal-grid
    role="group"
    aria-label="Choose a cleaning date"
    class="grid grid-cols-7 gap-1.5 sm:gap-2"
  >
    {ssrDays.map((day) => (
      <button
        type="button"
        data-cal-day={day.date}
        aria-pressed="false"
        class="flex min-h-[54px] flex-col items-center justify-center gap-1 rounded-xl border border-mist/35 bg-card/85 px-1 py-1.5 text-center text-spruce transition hover:border-eucalyptus cursor-pointer"
      >
        <span class="text-[10px] font-semibold uppercase tracking-wide text-spruce/70">
          {day.weekdayShort}
        </span>
        <span class="text-sm font-bold leading-none">{day.dayNum}</span>
        <span class="h-2 w-2 rounded-full bg-eucalyptus" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  <div
    data-cal-windows
    hidden
    class="rounded-2xl border border-mist/40 bg-card p-3.5 sm:p-4 space-y-3"
  >
    <div class="flex flex-wrap items-center justify-between gap-2">
      <p data-cal-day-heading class="text-xs sm:text-sm font-semibold text-spruce"></p>
      <span data-cal-scope-note class="text-[11px] font-medium text-eucalyptus"></span>
    </div>
    <div data-cal-window-buttons class="grid gap-2 sm:grid-cols-2"></div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-mist/30 bg-card/70 px-3.5 py-2.5 text-xs">
    <span data-selected-slot-summary aria-live="polite" class="font-medium text-spruce/85">
      Optional: Tap any open date above to reserve your Edmonton arrival window ($0 upfront).
    </span>
    <button
      type="button"
      data-cal-clear
      hidden
      class="inline-flex min-h-[36px] items-center rounded-full border border-mist/45 bg-linen px-3 py-1 text-[11px] font-semibold text-spruce hover:border-eucalyptus cursor-pointer"
    >
      Clear
    </button>
  </div>
</div>

<script>
  import type {
    CalendarDaySchedule,
    CalendarSchedulePayload,
    ServiceId,
    SlotWindow,
  } from '../types/contracts';

  const PAGE_SIZE = 14;

  function buildFallbackDays(): CalendarDaySchedule[] {
    const now = new Date();
    const ymdFmt = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Edmonton',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    });
    const wdFmt = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Edmonton',
      weekday: 'short',
    });
    const labelFmt = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Edmonton',
      weekday: 'short',
      month: 'short',
      day: 'numeric',
    });
    const parts = ymdFmt.formatToParts(now);
    const y = Number(parts.find((p) => p.type === 'year')?.value || '2026');
    const m = Number(parts.find((p) => p.type === 'month')?.value || '11');
    const d = Number(parts.find((p) => p.type === 'day')?.value || '28');

    const out: CalendarDaySchedule[] = [];
    for (let i = 1; i <= 42; i++) {
      const dt = new Date(Date.UTC(y, m - 1, d + i, 18, 0, 0));
      const dateStr = ymdFmt.format(dt);
      const wd = wdFmt.format(dt);
      const isWeekend = wd.startsWith('Sat') || wd.startsWith('Sun');
      const mState = i === 1 ? 'booked' : 'available';
      const aState = i === 3 ? 'pending' : 'available';
      const openCount = (mState === 'available' ? 1 : 0) + (aState === 'available' ? 1 : 0);
      out.push({
        date: dateStr,
        dayLabel: labelFmt.format(dt),
        weekdayShort: wd,
        isWeekend,
        morning: {
          window: 'morning',
          label: 'Morning',
          timeRange: '8:30 AM – 12:30 PM',
          state: mState,
        },
        afternoon: {
          window: 'afternoon',
          label: 'Afternoon',
          timeRange: '1:30 PM – 5:30 PM',
          state: aState,
        },
        availableWindows: openCount,
        fullDayAvailable: mState === 'available' && aState === 'available',
        statusSummary:
          openCount === 2 ? 'available' : openCount === 1 ? 'one_left' : 'booked',
      });
    }
    return out;
  }

  function formatMonthRange(slice: CalendarDaySchedule[]): string {
    if (!slice.length) return 'Edmonton Live Availability';
    const fmt = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Edmonton',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });
    const toDate = (ymd: string) => new Date(`${ymd}T18:00:00Z`);
    const first = fmt.format(toDate(slice[0].date));
    const last = fmt.format(toDate(slice[slice.length - 1].date));
    return `${first} – ${last}`;
  }

  function statusDotClass(summary: CalendarDaySchedule['statusSummary']): string {
    if (summary === 'available') return 'bg-eucalyptus';
    if (summary === 'one_left') return 'bg-brass';
    if (summary === 'pending') return 'bg-amber-600';
    return 'bg-rose-700';
  }

  document.querySelectorAll<HTMLElement>('[data-booking-calendar]').forEach((cal) => {
    const gridEl = cal.querySelector<HTMLElement>('[data-cal-grid]');
    const monthEl = cal.querySelector<HTMLElement>('[data-cal-month]');
    const prevBtn = cal.querySelector<HTMLButtonElement>('[data-cal-prev]');
    const nextBtn = cal.querySelector<HTMLButtonElement>('[data-cal-next]');
    const windowsPanel = cal.querySelector<HTMLElement>('[data-cal-windows]');
    const dayHeadingEl = cal.querySelector<HTMLElement>('[data-cal-day-heading]');
    const scopeNoteEl = cal.querySelector<HTMLElement>('[data-cal-scope-note]');
    const windowBtnsWrap = cal.querySelector<HTMLElement>('[data-cal-window-buttons]');
    const summaryEl = cal.querySelector<HTMLElement>('[data-selected-slot-summary]');
    const clearBtn = cal.querySelector<HTMLButtonElement>('[data-cal-clear]');

    let days: CalendarDaySchedule[] = buildFallbackDays();
    let pageIndex = 0;
    let expandedDate: string | null = null;
    let selectedDate: string | null = null;
    let selectedWindow: SlotWindow | null = null;

    let scopeMode: 'flat_rate' | 'hourly' =
      cal.dataset.initMode === 'hourly' ? 'hourly' : 'flat_rate';
    let scopeService: ServiceId = (cal.dataset.initService as ServiceId) || 'move_out';
    let scopeBedrooms = Number(cal.dataset.initBedrooms || '2') || 2;
    let scopeHours = Number(cal.dataset.initHours || '4') || 4;

    function requiresFullDay(): boolean {
      if (scopeMode === 'hourly') return scopeHours >= 6;
      return (scopeService === 'move_out' || scopeService === 'deep_clean') && scopeBedrooms >= 3;
    }

    function emitSlotChange(date: string | null, win: SlotWindow | null, label: string) {
      cal.dispatchEvent(
        new CustomEvent('levelup:slot-change', {
          bubbles: true,
          detail: { date, window: win, label },
        }),
      );
      if (summaryEl) {
        summaryEl.textContent =
          date && win
            ? `Selected: ${label}`
            : 'Optional: Tap any open date above to reserve your Edmonton arrival window ($0 upfront).';
      }
      if (clearBtn) {
        clearBtn.hidden = !(date && win);
      }
    }

    function renderWindowSelector() {
      if (!windowsPanel || !dayHeadingEl || !scopeNoteEl || !windowBtnsWrap) return;
      const day = days.find((d) => d.date === expandedDate);
      if (!day) {
        windowsPanel.hidden = true;
        return;
      }

      windowsPanel.hidden = false;
      dayHeadingEl.textContent = `${day.dayLabel} (${day.date})`;
      const fullDay = requiresFullDay();
      scopeNoteEl.textContent = fullDay
        ? 'Full-Day team block (3+ Bed Reset / 6+ hrs)'
        : 'Select Morning or Afternoon window';

      windowBtnsWrap.replaceChildren();

      if (fullDay) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.calWindow = 'full_day';
        const isSelected = selectedDate === day.date && selectedWindow === 'full_day';
        btn.disabled = !day.fullDayAvailable;
        btn.className = [
          'sm:col-span-2 flex min-h-[48px] items-center justify-between gap-2 rounded-xl border px-4 py-2.5 text-left text-xs sm:text-sm font-semibold transition',
          !day.fullDayAvailable
            ? 'border-mist/30 bg-linen/60 text-spruce/45 cursor-not-allowed'
            : isSelected
              ? 'border-eucalyptus bg-eucalyptus text-linen cursor-pointer'
              : 'border-mist/45 bg-linen text-spruce hover:border-eucalyptus cursor-pointer',
        ].join(' ');

        const left = document.createElement('span');
        left.textContent = 'Full Day Reset (8:30 AM – 4:30 PM)';
        const right = document.createElement('span');
        right.className = 'text-[11px] font-semibold';
        right.textContent = day.fullDayAvailable
          ? isSelected
            ? 'Selected ✓'
            : 'Open'
          : 'Needs both windows free';
        btn.append(left, right);

        btn.addEventListener('click', () => {
          if (!day.fullDayAvailable) return;
          selectedDate = day.date;
          selectedWindow = 'full_day';
          emitSlotChange(day.date, 'full_day', `${day.dayLabel} • Full Day Reset (8:30 AM – 4:30 PM)`);
          renderGrid();
          renderWindowSelector();
        });
        windowBtnsWrap.append(btn);
        return;
      }

      const options = [day.morning, day.afternoon];
      options.forEach((slot) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.calWindow = slot.window;
        const available = slot.state === 'available';
        const isSelected = selectedDate === day.date && selectedWindow === slot.window;
        btn.disabled = !available;
        btn.className = [
          'flex min-h-[48px] items-center justify-between gap-2 rounded-xl border px-3.5 py-2.5 text-left text-xs font-semibold transition',
          !available
            ? 'border-mist/30 bg-linen/60 text-spruce/45 cursor-not-allowed'
            : isSelected
              ? 'border-eucalyptus bg-eucalyptus text-linen cursor-pointer'
              : 'border-mist/45 bg-linen text-spruce hover:border-eucalyptus cursor-pointer',
        ].join(' ');

        const left = document.createElement('span');
        left.textContent = `${slot.label} (${slot.timeRange})`;
        const right = document.createElement('span');
        right.className = 'shrink-0 text-[11px]';
        right.textContent =
          slot.state === 'available'
            ? isSelected
              ? 'Selected ✓'
              : 'Open'
            : slot.state === 'pending'
              ? 'Pending'
              : 'Booked';
        btn.append(left, right);

        btn.addEventListener('click', () => {
          if (!available) return;
          selectedDate = day.date;
          selectedWindow = slot.window;
          emitSlotChange(
            day.date,
            slot.window,
            `${day.dayLabel} • ${slot.label} (${slot.timeRange})`,
          );
          renderGrid();
          renderWindowSelector();
        });
        windowBtnsWrap.append(btn);
      });
    }

    function renderGrid() {
      if (!gridEl) return;
      const totalPages = Math.max(1, Math.ceil(days.length / PAGE_SIZE));
      pageIndex = Math.min(totalPages - 1, Math.max(0, pageIndex));
      const slice = days.slice(pageIndex * PAGE_SIZE, (pageIndex + 1) * PAGE_SIZE);

      if (monthEl) monthEl.textContent = formatMonthRange(slice);
      if (prevBtn) prevBtn.disabled = pageIndex === 0;
      if (nextBtn) nextBtn.disabled = pageIndex >= totalPages - 1;

      gridEl.replaceChildren();
      const fullDay = requiresFullDay();

      slice.forEach((day) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.calDay = day.date;
        const isSelected = selectedDate === day.date;
        const isExpanded = expandedDate === day.date;
        const canBook = fullDay ? day.fullDayAvailable : day.availableWindows > 0;
        btn.disabled = !canBook;
        btn.setAttribute('aria-pressed', String(isSelected || isExpanded));
        btn.setAttribute('aria-label', `${day.dayLabel}, ${day.statusSummary.replace('_', ' ')}`);

        btn.className = [
          'flex min-h-[54px] flex-col items-center justify-center gap-1 rounded-xl border px-1 py-1.5 text-center transition',
          !canBook
            ? 'border-mist/25 bg-card/40 text-spruce/40 cursor-not-allowed'
            : isSelected
              ? 'border-eucalyptus bg-eucalyptus text-linen shadow-2xs cursor-pointer'
              : isExpanded
                ? 'border-eucalyptus bg-eucalyptus/12 text-spruce cursor-pointer'
                : 'border-mist/35 bg-card/85 text-spruce hover:border-eucalyptus cursor-pointer',
        ].join(' ');

        const wd = document.createElement('span');
        wd.className = isSelected
          ? 'text-[10px] font-semibold uppercase tracking-wide text-linen/85'
          : 'text-[10px] font-semibold uppercase tracking-wide text-spruce/70';
        wd.textContent = day.weekdayShort;

        const num = document.createElement('span');
        num.className = 'text-sm font-bold leading-none';
        num.textContent = String(Number(day.date.slice(8, 10)));

        const dot = document.createElement('span');
        dot.setAttribute('aria-hidden', 'true');
        dot.className = `h-2 w-2 rounded-full ${isSelected ? 'bg-linen' : statusDotClass(day.statusSummary)}`;

        btn.append(wd, num, dot);
        btn.addEventListener('click', () => {
          if (!canBook) return;
          expandedDate = day.date;
          renderGrid();
          renderWindowSelector();
        });
        gridEl.append(btn);
      });
    }

    async function loadLiveCalendar() {
      try {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 4000);
        const res = await fetch('/api/calendar', {
          headers: { Accept: 'application/json' },
          signal: controller.signal,
        });
        window.clearTimeout(timer);
        if (!res.ok) return;
        const ct = res.headers.get('content-type') || '';
        if (!ct.includes('application/json')) return;
        const data = (await res.json()) as CalendarSchedulePayload;
        if (!Array.isArray(data.days) || !data.days.length) return;

        days = data.days;
        if (typeof data.weeklyOpenSlots === 'number') {
          window.dispatchEvent(
            new CustomEvent('levelup:slots-sync', {
              detail: { weeklyOpenSlots: data.weeklyOpenSlots },
            }),
          );
        }
        if (selectedDate) {
          const match = days.find((d) => d.date === selectedDate);
          const stillOpen =
            match &&
            (selectedWindow === 'full_day'
              ? match.fullDayAvailable
              : selectedWindow === 'morning'
                ? match.morning.state === 'available'
                : selectedWindow === 'afternoon'
                  ? match.afternoon.state === 'available'
                  : false);
          if (!stillOpen) {
            selectedDate = null;
            selectedWindow = null;
            emitSlotChange(null, null, '');
          }
        }
        renderGrid();
        renderWindowSelector();
      } catch {
        renderGrid();
      }
    }

    prevBtn?.addEventListener('click', () => {
      if (pageIndex > 0) {
        pageIndex -= 1;
        renderGrid();
      }
    });

    nextBtn?.addEventListener('click', () => {
      const totalPages = Math.max(1, Math.ceil(days.length / PAGE_SIZE));
      if (pageIndex < totalPages - 1) {
        pageIndex += 1;
        renderGrid();
      }
    });

    clearBtn?.addEventListener('click', () => {
      selectedDate = null;
      selectedWindow = null;
      expandedDate = null;
      emitSlotChange(null, null, '');
      renderGrid();
      renderWindowSelector();
    });

    const scopeTarget = cal.closest('[data-calculator-root]') || cal;
    scopeTarget.addEventListener('levelup:quote-scope', ((
      ev: CustomEvent<{
        mode?: 'flat_rate' | 'hourly';
        service?: ServiceId;
        bedrooms?: number;
        hours?: number;
      }>,
    ) => {
      const prevFullDay = requiresFullDay();
      if (ev.detail?.mode) scopeMode = ev.detail.mode;
      if (ev.detail?.service) scopeService = ev.detail.service;
      if (typeof ev.detail?.bedrooms === 'number') scopeBedrooms = ev.detail.bedrooms;
      if (typeof ev.detail?.hours === 'number') scopeHours = ev.detail.hours;
      const nextFullDay = requiresFullDay();

      if (prevFullDay !== nextFullDay && selectedWindow) {
        selectedDate = null;
        selectedWindow = null;
        emitSlotChange(null, null, '');
      }
      renderGrid();
      renderWindowSelector();
    }) as EventListener);

    scopeTarget.addEventListener('levelup:calendar-refresh', () => {
      selectedDate = null;
      selectedWindow = null;
      emitSlotChange(null, null, '');
      loadLiveCalendar();
    });

    renderGrid();
    loadLiveCalendar();
  });
</script>
