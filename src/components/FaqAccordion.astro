---
import type { FaqItem } from '../types/contracts';

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  faqs: FaqItem[];
}

const {
  eyebrow = 'FREQUENTLY ASKED QUESTIONS',
  title = 'Straightforward Answers for Edmonton Homeowners & Renters',
  subtitle,
  faqs,
} = Astro.props;
---

<section class="py-14 sm:py-18">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-brass/45 bg-brass/15 px-3.5 py-1 text-xs font-semibold tracking-wider uppercase text-spruce">
        {eyebrow}
      </span>
      <h2 class="mt-3 font-serif text-3xl sm:text-4xl font-semibold text-spruce">
        {title}
      </h2>
      {subtitle && (
        <p class="mt-2.5 text-base text-spruce/80">{subtitle}</p>
      )}
    </div>

    <div class="mt-8 space-y-3">
      {faqs.map((faq, index) => (
        <details
          open={index === 0}
          class="group rounded-2xl border border-mist/35 bg-card/85 px-5 py-1 transition open:bg-card open:shadow-2xs"
        >
          <summary class="flex min-h-[52px] cursor-pointer items-center justify-between gap-4 py-3 text-left font-serif text-base sm:text-lg font-semibold text-spruce">
            <span>{faq.question}</span>
            <span
              class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-mist/40 bg-linen text-eucalyptus transition-transform duration-200 group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <div class="border-t border-mist/25 pb-4 pt-3 text-sm sm:text-base leading-relaxed text-spruce/85">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
