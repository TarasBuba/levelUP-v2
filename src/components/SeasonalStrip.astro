---
import siteCopy from '../data/site_copy.json';

const banner = siteCopy.home.seasonalBanner;
---

<div data-seasonal-strip class="border-b border-mist/25 bg-spruce text-linen">
  <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-2 px-4 py-2 sm:flex-row sm:items-center sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs sm:text-sm">
      <span
        data-seasonal-badge
        class="inline-flex items-center gap-1.5 rounded-full border border-brass/55 bg-brass/15 px-2.5 py-0.5 text-[11px] font-semibold tracking-wider uppercase text-linen"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-brass" aria-hidden="true"></span>
        <span data-seasonal-badge-text>{banner.badge}</span>
      </span>
      <p class="font-medium text-linen/95">
        <span data-seasonal-headline class="font-semibold text-linen">{banner.headline}:</span>{' '}
        <span data-seasonal-sub class="hidden md:inline text-linen/80">
          Save $50 on Holiday Deep Resets &amp; Move-Out Cleans ($0 upfront).
        </span>
      </p>
    </div>

    <div class="flex items-center gap-2 self-stretch sm:self-auto">
      <a
        href={`/?promo=${banner.promoCode}#quote-calculator`}
        data-seasonal-cta
        class="inline-flex min-h-[44px] flex-1 sm:flex-initial items-center justify-center rounded-full bg-eucalyptus px-3.5 py-1.5 text-xs font-semibold text-linen transition hover:bg-eucalyptus-hover whitespace-nowrap shrink-0"
      >
        {banner.ctaLabel} →
      </a>
      <a
        href={banner.secondaryCtaHref}
        data-seasonal-secondary
        class="inline-flex min-h-[44px] items-center justify-center rounded-full border border-mist/45 px-3.5 py-1.5 text-xs font-semibold text-linen transition hover:bg-linen/10 whitespace-nowrap shrink-0"
      >
        {banner.secondaryCtaLabel}
      </a>
    </div>
  </div>
</div>

<script>
  const strip = document.querySelector<HTMLElement>('[data-seasonal-strip]');
  if (strip) {
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Edmonton',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(new Date());

    const year = Number(parts.find((p) => p.type === 'year')?.value || '2026');
    const month = Number(parts.find((p) => p.type === 'month')?.value || '11');
    const day = Number(parts.find((p) => p.type === 'day')?.value || '1');

    let badge = `EDMONTON ${year}`;
    let headline = 'Autumn Deep Home Reset';
    let sub = 'Clear summer dust & prep for winter with 100% pet-safe botanicals ($0 upfront).';
    let ctaLabel = 'Book Autumn Reset →';
    let promo = '25';

    if (day >= 18) {
      badge = 'END-OF-MONTH MOVE-OUT RUSH • EDMONTON';
      headline = 'Move-Out Inspection Rush';
      sub = 'Lock $50 OFF Move-Out Cleans — Oven, Fridge & Cabinets included FREE + RTA Landlord Receipt.';
      ctaLabel = 'Claim $50 Move-Out Slot →';
      promo = '50';
    } else if ((month === 11 && day >= 15) || month === 12) {
      badge = `HOLIDAY SEASON ${year} • EDMONTON`;
      headline = 'December Holiday Reset & Gift a Clean';
      sub = 'Save $50 on Holiday Deep Resets & Move-Out Cleans before hosting ($0 upfront).';
      ctaLabel = 'Claim Holiday Slot →';
      promo = 'holiday50';
    } else if (month >= 1 && month <= 3) {
      badge = `ALBERTA WINTER ${year} • EDMONTON`;
      headline = 'Alberta Winter Salt & Furnace Dust Reset';
      sub = 'Dry-HEPA grit extraction & pH-neutral floor care for snowy Edmonton entryways ($0 upfront).';
      ctaLabel = 'Book Winter Reset →';
      promo = '25';
    } else if (month >= 4 && month <= 5) {
      badge = `SPRING THAW ${year} • EDMONTON`;
      headline = 'Edmonton Spring Deep Reset';
      sub = '50-point baseboards, tracks, furnace dust & hard-water shower glass restoration.';
      ctaLabel = 'Book Spring Reset →';
      promo = '25';
    } else if (month >= 6 && month <= 8) {
      badge = `SUMMER ${year} • EDMONTON`;
      headline = 'Festival Season & Airbnb Turnovers';
      sub = 'Same-day 11am–3pm short-term turnovers & calm weekend home resets ($0 upfront).';
      ctaLabel = 'Lock Summer Slot →';
      promo = '25';
    } else {
      badge = `AUTUMN ${year} • EDMONTON`;
      headline = 'Autumn Deep Home Reset';
      sub = 'Refresh baseboards, kitchens & baths before sealed-window season ($0 upfront).';
      ctaLabel = 'Book Autumn Reset →';
      promo = '25';
    }

    const badgeText = strip.querySelector<HTMLElement>('[data-seasonal-badge-text]');
    const headEl = strip.querySelector<HTMLElement>('[data-seasonal-headline]');
    const subEl = strip.querySelector<HTMLElement>('[data-seasonal-sub]');
    const ctaEl = strip.querySelector<HTMLAnchorElement>('[data-seasonal-cta]');

    if (badgeText) badgeText.textContent = badge;
    if (headEl) headEl.textContent = `${headline}:`;
    if (subEl) subEl.textContent = sub;
    if (ctaEl) {
      ctaEl.textContent = ctaLabel;
      ctaEl.href = `/?promo=${promo}#quote-calculator`;
    }
  }
</script>
