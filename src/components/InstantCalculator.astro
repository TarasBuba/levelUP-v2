              <span data-line-freq-label>Recurring Plan Discount ({initialQuote.frequencyDiscountPct}%)</span>
              <span data-line-freq class="font-semibold text-brass">−${initialQuote.frequencyDiscountCad}</span>
            </div>

            <div
              data-row-promo
              hidden={initialQuote.promo.discountCad <= 0}
              class="flex items-center justify-between gap-3 text-linen"
            >
              <span data-line-promo-label>Active Promo Savings</span>
              <span data-line-promo class="font-semibold text-brass">−${initialQuote.promo.discountCad}</span>
            </div>
          </div>

          <!-- Due Today $0 Assurance -->
          <div class="rounded-2xl bg-linen/10 p-4 space-y-1.5">
            <div class="flex items-center justify-between text-sm font-bold text-linen">
              <span>Due Today to Book</span>
              <span class="text-brass">$0.00 CAD</span>
