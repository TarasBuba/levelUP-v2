---
import type { AddonId, Frequency, ServiceId } from '../types/contracts';
import strategy from '../data/strategy.json';
import { buildSmsPrefillHref, calculateQuote } from '../lib/pricing';

interface Props {
  defaultService?: ServiceId;
  defaultBedrooms?: number;
  defaultBathrooms?: number;
  defaultFrequency?: Frequency;
  defaultAddons?: AddonId[];
  defaultPromoCode?: string;
  compact?: boolean;
}

const {
  defaultService = 'move_out',
  defaultBedrooms = 2,
  defaultBathrooms = 2,
  defaultFrequency = 'one_time',
  defaultAddons = [],
  defaultPromoCode = '',
  compact = false,
} = Astro.props;

const initialMode = defaultService === 'hourly' ? 'hourly' : 'flat_rate';
const initialQuote = calculateQuote({
  mode: initialMode,
  service: defaultService,
  bedrooms: defaultBedrooms,
  bathrooms: defaultBathrooms,
  frequency: defaultFrequency,
  addons: defaultAddons,
  hours: 4,
  cleaners: 1,
  promoQuery: defaultPromoCode || null,
});

const initialSmsHref = buildSmsPrefillHref(initialQuote);

const packageOptions: Array<{ id: Exclude<ServiceId, 'hourly'>; label: string; tag: string; fromCad: number }> = [
  { id: 'move_out', label: 'Move-Out / Move-In', tag: 'Oven + Fridge + Cabinets FREE', fromCad: 235 },
  { id: 'deep_clean', label: '50-Point Deep Reset', tag: 'Baseboards, Salt & Scale', fromCad: 210 },
  { id: 'regular', label: 'Recurring Eco Clean', tag: 'Up to 15% Off Weekly', fromCad: 130 },
  { id: 'airbnb', label: 'Airbnb 5-Star Turnover', tag: 'Same-Day Photo Staging', fromCad: 120 },
];

const frequencyOptions: Array<{ id: Frequency; label: string; sub: string }> = [
  { id: 'one_time', label: 'One-Time', sub: 'Standard' },
  { id: 'monthly', label: 'Monthly', sub: '5% Off' },
  { id: 'biweekly', label: 'Bi-Weekly', sub: '10% Off' },
  { id: 'weekly', label: 'Weekly', sub: '15% Off' },
];

const addonEntries = Object.entries(strategy.pricing.addons) as Array<
  [AddonId, { label: string; priceCad: number }]
>;

const moveOutFreeSet = new Set<AddonId>(['inside_oven', 'inside_fridge', 'inside_cabinets']);
---

<section
  id="quote-calculator"
  data-calculator-root
  data-default-mode={initialMode}
  data-default-service={defaultService}
  data-default-bedrooms={String(defaultBedrooms)}
  data-default-bathrooms={String(defaultBathrooms)}
  data-default-frequency={defaultFrequency}
  data-default-addons={JSON.stringify(defaultAddons)}
  data-default-promo={defaultPromoCode}
  class:list={[compact ? 'py-8 sm:py-10' : 'py-14 sm:py-20']}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {!compact && (
      <div class="max-w-3xl mb-8 sm:mb-10">
        <span class="inline-flex items-center gap-2 rounded-full border border-brass/45 bg-brass/15 px-3.5 py-1 text-xs font-semibold tracking-wider uppercase text-spruce">
          <span class="h-1.5 w-1.5 rounded-full bg-brass" aria-hidden="true"></span>
          45-Second Hybrid Quote Engine • $0 Upfront Deposit
        </span>
        <h2 class="mt-3 font-serif text-3xl sm:text-4xl font-semibold text-spruce">
          Instant Edmonton Flat-Rate &amp; Hourly Price Calculator
        </h2>
        <p class="mt-2.5 text-base leading-relaxed text-spruce/80">
          Transparent pre-tax Canadian dollars (+ 5% AB GST where applicable). Check your Edmonton postal zone, customize your rooms, and reserve with $0 down today.
        </p>
      </div>
    )}

    <form
      data-calc-form
      novalidate
      class="grid gap-6 lg:grid-cols-12 lg:items-start"
    >
      <!-- Left Column: Steps 1, 2 & 3 Controls -->
      <div class="lg:col-span-7 space-y-6">
        <!-- STEP 1: Edmonton Postal FSA Check -->
        <div class="rounded-3xl border border-mist/35 bg-card p-5 sm:p-7 shadow-2xs">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-spruce font-mono text-xs font-bold text-linen">
              1
            </span>
            <h3 class="font-serif text-lg sm:text-xl font-semibold text-spruce">
              Check Your Greater Edmonton Postal Code
            </h3>
          </div>

          <div class="mt-4 grid gap-3 sm:grid-cols-12 sm:items-center">
            <div class="sm:col-span-5">
              <label for="calc-postal-input" class="sr-only">
                Edmonton or Capital Region Postal Code (FSA)
              </label>
              <input
                id="calc-postal-input"
                name="postalCode"
                type="text"
                inputmode="text"
                maxlength="7"
                autocomplete="postal-code"
                placeholder="e.g. T5K, T6W, T8N"
                data-postal-input
                class="w-full min-h-[48px] rounded-2xl border border-mist/50 bg-linen px-4 py-3 text-base font-semibold uppercase tracking-wider text-spruce placeholder:font-normal placeholder:normal-case placeholder:tracking-normal placeholder:text-spruce/50 focus:border-eucalyptus"
              />
            </div>
            <div class="sm:col-span-7">
              <div
                data-postal-badge
                aria-live="polite"
                class="flex min-h-[48px] items-center rounded-2xl border border-mist/30 bg-linen/80 px-4 py-2.5 text-xs sm:text-sm text-spruce/80"
              >
                Enter your 3-character FSA (T5*, T6*, T8N, T8A, T7X, T9E…) to verify $0 travel zone.
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2: Dual-Path & Room Customization -->
        <div class="rounded-3xl border border-mist/35 bg-card p-5 sm:p-7 shadow-2xs space-y-6">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-2.5">
              <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-spruce font-mono text-xs font-bold text-linen">
                2
              </span>
              <h3 class="font-serif text-lg sm:text-xl font-semibold text-spruce">
                Customize Your Clean
              </h3>
            </div>

            <!-- Dual-Path Toggle -->
            <div
              role="group"
              aria-label="Pricing mode toggle"
              class="inline-grid grid-cols-2 rounded-full border border-mist/40 bg-linen p-1"
            >
              <button
                type="button"
                data-mode-btn="flat_rate"
                aria-pressed={initialMode === 'flat_rate' ? 'true' : 'false'}
                class:list={[
                  'min-h-[44px] rounded-full px-3.5 py-2 text-xs font-semibold transition cursor-pointer',
                  initialMode === 'flat_rate'
                    ? 'bg-eucalyptus text-linen shadow-2xs'
                    : 'text-spruce hover:bg-card',
                ]}
              >
                Flat-Rate Packages
              </button>
              <button
                type="button"
                data-mode-btn="hourly"
                aria-pressed={initialMode === 'hourly' ? 'true' : 'false'}
                class:list={[
                  'min-h-[44px] rounded-full px-3.5 py-2 text-xs font-semibold transition cursor-pointer',
                  initialMode === 'hourly'
                    ? 'bg-eucalyptus text-linen shadow-2xs'
                    : 'text-spruce hover:bg-card',
                ]}
              >
                Hourly Custom ($48/hr)
              </button>
            </div>
          </div>

          <!-- Flat-Rate Controls -->
          <div data-flat-rate-panel hidden={initialMode !== 'flat_rate'} class="space-y-6">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-spruce/75 mb-2.5">
                Select Cleaning Package
              </p>
              <div class="grid gap-2.5 sm:grid-cols-2">
                {packageOptions.map((pkg) => {
                  const active = defaultService === pkg.id;
                  return (
                    <button
                      type="button"
                      data-service-btn={pkg.id}
                      aria-pressed={active ? 'true' : 'false'}
                      class:list={[
                        'flex min-h-[64px] flex-col items-start justify-center rounded-2xl border p-3.5 text-left transition cursor-pointer',
                        active
                          ? 'border-eucalyptus bg-eucalyptus text-linen shadow-xs'
                          : 'border-mist/35 bg-linen text-spruce hover:border-eucalyptus',
                      ]}
                    >
                      <span class="flex w-full items-center justify-between gap-2 text-sm font-semibold">
                        <span>{pkg.label}</span>
                        <span class="font-mono text-xs opacity-90">From ${pkg.fromCad}</span>
                      </span>
                      <span
                        data-service-tag
                        class:list={[
                          'mt-0.5 text-xs',
                          active ? 'text-linen/90' : 'text-spruce/75',
                        ]}
                      >
                        {pkg.tag}
                      </span>
                    </button>
                  );
                })}
              </div>
            </div>

            <!-- Bedrooms & Bathrooms -->
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-spruce/75 mb-2">
                  Bedrooms
                </p>
                <div class="grid grid-cols-5 gap-1.5" role="group" aria-label="Number of bedrooms">
                  {[1, 2, 3, 4, 5].map((num) => {
                    const active = num === defaultBedrooms;
                    return (
                      <button
                        type="button"
                        data-bed-btn={String(num)}
                        aria-label={`${num} ${num === 1 ? 'bedroom' : 'bedrooms'}`}
                        aria-pressed={active ? 'true' : 'false'}
                        class:list={[
                          'min-h-[44px] rounded-xl border text-sm font-semibold transition cursor-pointer',
                          active
                            ? 'border-eucalyptus bg-eucalyptus text-linen'
                            : 'border-mist/35 bg-linen text-spruce hover:border-eucalyptus',
                        ]}
                      >
                        {num}
                      </button>
                    );
                  })}
                </div>
              </div>

              <div>
                <div class="flex items-center justify-between mb-2">
                  <p class="text-xs font-bold uppercase tracking-wider text-spruce/75">
                    Bathrooms
                  </p>
                  <span class="text-[11px] text-spruce/70">1st incl., +$25/extra</span>
                </div>
                <div class="grid grid-cols-5 gap-1.5" role="group" aria-label="Number of bathrooms">
                  {[1, 2, 3, 4, 5].map((num) => {
                    const active = num === defaultBathrooms;
                    return (
                      <button
                        type="button"
                        data-bath-btn={String(num)}
                        aria-label={`${num} ${num === 1 ? 'bathroom' : 'bathrooms'}`}
                        aria-pressed={active ? 'true' : 'false'}
                        class:list={[
                          'min-h-[44px] rounded-xl border text-sm font-semibold transition cursor-pointer',
                          active
                            ? 'border-eucalyptus bg-eucalyptus text-linen'
                            : 'border-mist/35 bg-linen text-spruce hover:border-eucalyptus',
                        ]}
                      >
                        {num}
                      </button>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>

          <!-- Hourly Custom Clean Controls -->
          <div data-hourly-panel hidden={initialMode !== 'hourly'} class="space-y-5">
            <div class="rounded-2xl border border-eucalyptus/30 bg-eucalyptus/8 p-4 text-xs sm:text-sm text-spruce">
              <span class="font-semibold">$48/hr per specialist</span> (below the $50/hr Edmonton 30-company median). Hand us your priority room list—we work top-to-bottom with commercial HEPA &amp; botanical kits.
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-spruce/75 mb-2">
                  Hours (3 to 10 hrs)
                </p>
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    data-hours-step="-1"
                    aria-label="Decrease hours"
                    class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-xl border border-mist/40 bg-linen text-base font-bold text-spruce hover:border-eucalyptus cursor-pointer"
                  >
                    −
                  </button>
                  <div
                    data-hours-display
                    class="flex min-h-[44px] flex-1 items-center justify-center rounded-xl border border-mist/35 bg-linen font-semibold text-spruce text-sm"
                  >
                    4 Hours
                  </div>
                  <button
                    type="button"
                    data-hours-step="1"
                    aria-label="Increase hours"
                    class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-xl border border-mist/40 bg-linen text-base font-bold text-spruce hover:border-eucalyptus cursor-pointer"
                  >
                    +
                  </button>
                </div>
              </div>

              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-spruce/75 mb-2">
                  Specialists (1 to 3)
                </p>
                <div class="grid grid-cols-3 gap-2" role="group" aria-label="Number of cleaning specialists">
                  {[1, 2, 3].map((count) => (
                    <button
                      type="button"
                      data-cleaner-btn={String(count)}
                      aria-pressed={count === 1 ? 'true' : 'false'}
                      class:list={[
                        'min-h-[44px] rounded-xl border text-xs sm:text-sm font-semibold transition cursor-pointer',
                        count === 1
                          ? 'border-eucalyptus bg-eucalyptus text-linen'
                          : 'border-mist/35 bg-linen text-spruce hover:border-eucalyptus',
                      ]}
                    >
                      {count} {count === 1 ? 'Cleaner' : 'Cleaners'}
                    </button>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Frequency Selector -->
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
              <p class="text-xs font-bold uppercase tracking-wider text-spruce/75">
                Visit Frequency
              </p>
              <span
                data-moveout-freq-note
                hidden={!(initialMode === 'flat_rate' && defaultService === 'move_out')}
                class="text-xs font-medium text-eucalyptus"
              >
                Move-Out is a one-time inspection package
              </span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" role="group" aria-label="Cleaning frequency">
              {frequencyOptions.map((freq) => {
                const isMoveOutInit = initialMode === 'flat_rate' && defaultService === 'move_out';
                const active = isMoveOutInit ? freq.id === 'one_time' : freq.id === defaultFrequency;
                const disabled = isMoveOutInit && freq.id !== 'one_time';
                return (
                  <button
                    type="button"
                    data-freq-btn={freq.id}
                    disabled={disabled}
                    aria-pressed={active ? 'true' : 'false'}
                    class:list={[
                      'flex min-h-[48px] flex-col items-center justify-center rounded-xl border px-3 py-2 text-xs transition',
                      active
                        ? 'border-eucalyptus bg-eucalyptus text-linen font-semibold'
                        : 'border-mist/35 bg-linen text-spruce hover:border-eucalyptus',
                      disabled ? 'opacity-45 cursor-not-allowed' : 'cursor-pointer',
                    ]}
                  >
                    <span class="font-semibold">{freq.label}</span>
                    <span class="text-[11px] opacity-85">{freq.sub}</span>
                  </button>
                );
              })}
            </div>
          </div>

          <!-- Detail Add-Ons (Auto-locks Oven + Fridge + Cabinets FREE on Move-Out) -->
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
              <p class="text-xs font-bold uppercase tracking-wider text-spruce/75">
                Precision Add-Ons
              </p>
              <span
                data-moveout-free-banner
                hidden={!(initialMode === 'flat_rate' && defaultService === 'move_out')}
                class="inline-flex items-center gap-1 rounded-full bg-eucalyptus/15 border border-eucalyptus/35 px-3 py-0.5 text-xs font-semibold text-eucalyptus"
              >
                ✓ Oven + Fridge + Cabinets Included FREE ($135 value)
              </span>
            </div>

            <div class="grid gap-2 sm:grid-cols-2">
              {addonEntries.map(([addonId, addonCfg]) => {
                const isLockedFree =
                  initialMode === 'flat_rate' &&
                  defaultService === 'move_out' &&
                  moveOutFreeSet.has(addonId);
                const isChecked = isLockedFree || defaultAddons.includes(addonId);
                return (
                  <label
                    data-addon-card={addonId}
                    class:list={[
                      'flex min-h-[48px] items-center justify-between gap-2.5 rounded-2xl border px-3.5 py-2.5 text-xs sm:text-sm transition cursor-pointer',
                      isChecked
                        ? 'border-eucalyptus bg-eucalyptus/10 text-spruce font-medium'
                        : 'border-mist/35 bg-linen text-spruce hover:border-eucalyptus',
                    ]}
                  >
                    <span class="flex items-center gap-2.5 min-w-0">
                      <input
                        type="checkbox"
                        value={addonId}
                        checked={isChecked}
                        disabled={isLockedFree}
                        data-addon-checkbox={addonId}
                        class="h-4 w-4 shrink-0 rounded accent-eucalyptus"
                      />
                      <span class="truncate">{addonCfg.label}</span>
                    </span>
                    <span
                      data-addon-price-pill={addonId}
                      data-regular-price={String(addonCfg.priceCad)}
                      class:list={[
                        'shrink-0 rounded-full px-2.5 py-0.5 text-[11px] font-semibold',
                        isLockedFree
                          ? 'bg-eucalyptus text-linen'
                          : 'bg-card text-spruce/85',
                      ]}
                    >
                      {isLockedFree ? 'Included FREE' : `+$${addonCfg.priceCad}`}
                    </span>
                  </label>
                );
              })}
            </div>
          </div>
        </div>

        <!-- STEP 3: Lock In Date ($0 Upfront) + Snap & Lock + CASL Gate -->
        <div class="rounded-3xl border border-mist/35 bg-card p-5 sm:p-7 shadow-2xs space-y-5">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-spruce font-mono text-xs font-bold text-linen">
              3
            </span>
            <div>
              <h3 class="font-serif text-lg sm:text-xl font-semibold text-spruce">
                Reserve With $0 Upfront Deposit
              </h3>
              <p class="text-xs text-spruce/75">
                Pay only after your 50-point walkthrough sign-off (or SMS photo-verified report).
              </p>
            </div>
          </div>

          <!-- Hidden Honeypot -->
          <div class="hidden" aria-hidden="true">
            <label>
              Website URL
              <input type="text" name="honeypot" tabindex="-1" autocomplete="off" data-honeypot />
            </label>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="calc-name" class="block text-xs font-semibold text-spruce mb-1.5">
                Full Name <span class="text-eucalyptus">*</span>
              </label>
              <input
                id="calc-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Jordan Taylor"
                data-name-input
                class="w-full min-h-[46px] rounded-xl border border-mist/45 bg-linen px-3.5 py-2.5 text-sm text-spruce placeholder:text-spruce/45 focus:border-eucalyptus"
              />
            </div>

            <div>
              <label for="calc-phone" class="block text-xs font-semibold text-spruce mb-1.5">
                Mobile Number (for SMS quote) <span class="text-eucalyptus">*</span>
              </label>
              <input
                id="calc-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="(780) 710-1503"
                data-phone-input
                class="w-full min-h-[46px] rounded-xl border border-mist/45 bg-linen px-3.5 py-2.5 text-sm text-spruce placeholder:text-spruce/45 focus:border-eucalyptus"
              />
            </div>

            <div>
              <label for="calc-email" class="block text-xs font-semibold text-spruce mb-1.5">
                Email <span class="font-normal text-spruce/70">(Optional — for itemized receipt)</span>
              </label>
              <input
                id="calc-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="you@example.ca"
                data-email-input
                class="w-full min-h-[46px] rounded-xl border border-mist/45 bg-linen px-3.5 py-2.5 text-sm text-spruce placeholder:text-spruce/45 focus:border-eucalyptus"
              />
            </div>

            <div>
              <label for="calc-date" class="block text-xs font-semibold text-spruce mb-1.5">
                Preferred Cleaning Date <span class="font-normal text-spruce/70">(Optional)</span>
              </label>
              <input
                id="calc-date"
                name="preferredDate"
                type="date"
                data-date-input
                class="w-full min-h-[46px] rounded-xl border border-mist/45 bg-linen px-3.5 py-2.5 text-sm text-spruce focus:border-eucalyptus"
              />
            </div>
          </div>

          <label class="flex min-h-[44px] items-center gap-3 rounded-2xl border border-mist/35 bg-linen px-4 py-2.5 text-xs sm:text-sm font-medium text-spruce cursor-pointer">
            <input
              type="checkbox"
              name="hasPets"
              data-pets-input
              class="h-4 w-4 shrink-0 rounded accent-eucalyptus"
            />
            <span>Pets at home (our 100% bleach-free botanical eucalyptus kit is standard on every visit)</span>
          </label>

          <!-- Snap & Lock Exact Price (Canvas Browser Compression) -->
          <div class="rounded-2xl border border-dashed border-mist/60 bg-linen/90 p-4 space-y-2.5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <p class="text-xs sm:text-sm font-semibold text-spruce">
                  Snap &amp; Lock Exact Price <span class="font-normal text-spruce/70">(Optional • 1–2 photos)</span>
                </p>
                <p class="text-xs text-spruce/75">
                  Attach up to 2 quick kitchen/bath photos so our Edmonton lead team locks your exact rate before arrival.
                </p>
              </div>
              <label class="inline-flex min-h-[44px] items-center justify-center rounded-full border border-spruce/25 bg-card px-4 py-2 text-xs font-semibold text-spruce hover:border-eucalyptus cursor-pointer">
                <span>+ Attach Photos</span>
                <input
                  type="file"
                  accept="image/*"
                  multiple
                  data-snap-input
                  class="sr-only"
                />
              </label>
            </div>
            <div data-snap-status class="text-xs text-spruce/75" aria-live="polite"></div>
          </div>

          <div>
            <label for="calc-notes" class="block text-xs font-semibold text-spruce mb-1.5">
              Access / Surface Notes <span class="font-normal text-spruce/70">(Optional — condo buzzer, lockbox, marble/quartz notes)</span>
            </label>
            <textarea
              id="calc-notes"
              name="notes"
              rows="2"
              placeholder="e.g. Vacant condo with lockbox, Calacatta quartz island, need RTA landlord receipt..."
              data-notes-input
              class="w-full rounded-xl border border-mist/45 bg-linen px-3.5 py-2.5 text-sm text-spruce placeholder:text-spruce/45 focus:border-eucalyptus"
            ></textarea>
          </div>

          <!-- Mandatory Unchecked CASL SMS Consent Gate -->
          <label
            data-casl-wrapper
            class="flex min-h-[48px] items-start gap-3 rounded-2xl border border-mist/45 bg-linen p-3.5 text-xs leading-relaxed text-spruce cursor-pointer"
          >
            <input
              type="checkbox"
              name="caslSmsConsent"
              data-casl-checkbox
              class="mt-0.5 h-4 w-4 shrink-0 rounded accent-eucalyptus"
            />
            <span>
              <strong class="font-semibold">CASL SMS Consent (Required):</strong> I consent to receive text messages from LevelUp Cleaning (+1 (780) 710-1503) regarding my quote, scheduling, walkthrough photo report, and occasional Edmonton seasonal offers. Standard message rates apply; reply STOP anytime. <a href="/privacy" class="underline font-semibold hover:text-eucalyptus">Privacy &amp; CASL Terms</a>.
            </span>
          </label>

          <!-- Validation Alert -->
          <div
            data-form-error
            role="alert"
            hidden
