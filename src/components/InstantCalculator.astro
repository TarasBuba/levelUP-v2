</section>

<script>
  import type {
    AddonId,
    AttributionData,
    Frequency,
    LeadSubmissionPayload,
    LeadSubmissionResult,
    QuoteInput,
    ServiceId,
    SnapPhotoAttachment,
  } from '../types/contracts';
  import { lookupPostalCode } from '../lib/postal';
  import { buildSmsPrefillHref, calculateQuote } from '../lib/pricing';

  const MOVE_OUT_FREE_IDS: readonly AddonId[] = ['inside_oven', 'inside_fridge', 'inside_cabinets'];

  function readCookie(name: string): string | undefined {
    const match = document.cookie
      .split('; ')
      .find((row) => row.startsWith(`${name}=`));
    return match ? decodeURIComponent(match.split('=')[1] || '') : undefined;
  }

  function generateEventId(): string {
    if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
      return crypto.randomUUID();
    }
    return `lup-${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
  }

  async function compressImageFile(file: File): Promise<SnapPhotoAttachment> {
    const bitmapUrl = URL.createObjectURL(file);
    try {
      const img = await new Promise<HTMLImageElement>((resolve, reject) => {
        const el = new Image();
        el.onload = () => resolve(el);
        el.onerror = () => reject(new Error('Could not decode selected photo.'));
        el.src = bitmapUrl;
      });

      const maxDim = 1024;
      let { width, height } = img;
      if (width > maxDim || height > maxDim) {
        if (width >= height) {
          height = Math.max(1, Math.round((height * maxDim) / width));
          width = maxDim;
        } else {
          width = Math.max(1, Math.round((width * maxDim) / height));
          height = maxDim;
        }
      }

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      if (!ctx) {
        throw new Error('Canvas compression context unavailable.');
      }
      ctx.drawImage(img, 0, 0, width, height);

      // Compress iteratively to stay well under 350 KB (~466,000 base64 chars)
      let quality = 0.78;
      let base64Data = '';
      while (quality >= 0.45) {
        const dataUrl = canvas.toDataURL('image/jpeg', quality);
        base64Data = dataUrl.split(',')[1] || '';
        if (base64Data.length <= 450_000) break;
        quality -= 0.12;
      }

      const safeBase = file.name.replace(/\.[^.]+$/, '').replace(/[^a-zA-Z0-9_-]/g, '_').slice(0, 60) || 'room';
      return {
        filename: `${safeBase}.jpg`,
        mimeType: 'image/jpeg',
        base64Data,
      };
    } finally {
      URL.revokeObjectURL(bitmapUrl);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-calculator-root]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-calc-form]');
    if (!form) return;

    const urlParams = new URLSearchParams(window.location.search);
    const urlPromo = urlParams.get('promo') || urlParams.get('offer');
    const initialPromo = urlPromo || root.dataset.defaultPromo || null;

    let mode: 'flat_rate' | 'hourly' =
      root.dataset.defaultMode === 'hourly' ? 'hourly' : 'flat_rate';
    let service: ServiceId = (root.dataset.defaultService as ServiceId) || 'move_out';
    if (mode === 'flat_rate' && service === 'hourly') service = 'move_out';

    let bedrooms = Number(root.dataset.defaultBedrooms || '2') || 2;
    let bathrooms = Number(root.dataset.defaultBathrooms || '2') || 2;
    let frequency: Frequency = (root.dataset.defaultFrequency as Frequency) || 'one_time';
    let hours = 4;
    let cleaners = 1;
    let postalCode = '';
    let userAddons = new Set<AddonId>(
      JSON.parse(root.dataset.defaultAddons || '[]') as AddonId[],
    );
    let snapPhotos: SnapPhotoAttachment[] = [];

    const postalInput = root.querySelector<HTMLInputElement>('[data-postal-input]');
    const postalBadge = root.querySelector<HTMLElement>('[data-postal-badge]');
    const flatPanel = root.querySelector<HTMLElement>('[data-flat-rate-panel]');
    const hourlyPanel = root.querySelector<HTMLElement>('[data-hourly-panel]');
    const hoursDisplay = root.querySelector<HTMLElement>('[data-hours-display]');
    const moveOutFreqNote = root.querySelector<HTMLElement>('[data-moveout-freq-note]');
    const moveOutFreeBanner = root.querySelector<HTMLElement>('[data-moveout-free-banner]');

    const nameInput = root.querySelector<HTMLInputElement>('[data-name-input]');
    const phoneInput = root.querySelector<HTMLInputElement>('[data-phone-input]');
    const emailInput = root.querySelector<HTMLInputElement>('[data-email-input]');
    const dateInput = root.querySelector<HTMLInputElement>('[data-date-input]');
    const petsInput = root.querySelector<HTMLInputElement>('[data-pets-input]');
    const notesInput = root.querySelector<HTMLTextAreaElement>('[data-notes-input]');
    const honeypotInput = root.querySelector<HTMLInputElement>('[data-honeypot]');
    const snapInput = root.querySelector<HTMLInputElement>('[data-snap-input]');
    const snapStatus = root.querySelector<HTMLElement>('[data-snap-status]');
    const caslCheckbox = root.querySelector<HTMLInputElement>('[data-casl-checkbox]');
    const caslWrapper = root.querySelector<HTMLElement>('[data-casl-wrapper]');
    const errorBox = root.querySelector<HTMLElement>('[data-form-error]');
    const successBox = root.querySelector<HTMLElement>('[data-form-success]');
    const successDetail = root.querySelector<HTMLElement>('[data-success-detail]');
    const successSms = root.querySelector<HTMLAnchorElement>('[data-success-sms]');
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-submit-btn]');
    const smsPrefillLink = root.querySelector<HTMLAnchorElement>('[data-sms-prefill]');

    // Summary DOM refs
    const finalEl = root.querySelector<HTMLElement>('[data-quote-final]');
    const gstEl = root.querySelector<HTMLElement>('[data-quote-gst]');
    const promoBadgeEl = root.querySelector<HTMLElement>('[data-quote-promo-badge]');
    const savingsPillEl = root.querySelector<HTMLElement>('[data-quote-savings-pill]');
    const freeBundleEl = root.querySelector<HTMLElement>('[data-quote-free-bundle]');
    const serviceLabelEl = root.querySelector<HTMLElement>('[data-line-service-label]');
    const basePriceEl = root.querySelector<HTMLElement>('[data-line-base-price]');
    const rowBaths = root.querySelector<HTMLElement>('[data-row-baths]');
    const lineBaths = root.querySelector<HTMLElement>('[data-line-baths]');
    const rowAddons = root.querySelector<HTMLElement>('[data-row-addons]');
    const lineAddons = root.querySelector<HTMLElement>('[data-line-addons]');
    const lineTravelLabel = root.querySelector<HTMLElement>('[data-line-travel-label]');
    const lineTravel = root.querySelector<HTMLElement>('[data-line-travel]');
    const rowFreq = root.querySelector<HTMLElement>('[data-row-freq]');
    const lineFreqLabel = root.querySelector<HTMLElement>('[data-line-freq-label]');
    const lineFreq = root.querySelector<HTMLElement>('[data-line-freq]');
    const rowPromo = root.querySelector<HTMLElement>('[data-row-promo]');
    const linePromo = root.querySelector<HTMLElement>('[data-line-promo]');

    function buildCurrentQuoteInput(): QuoteInput {
      const effectiveFreq: Frequency =
        mode === 'flat_rate' && service === 'move_out' ? 'one_time' : frequency;
      return {
        mode,
        service: mode === 'hourly' ? 'hourly' : service,
        bedrooms,
        bathrooms,
        frequency: effectiveFreq,
        addons: Array.from(userAddons),
        hours,
        cleaners,
        postalCode,
        promoQuery: initialPromo,
      };
    }

    function syncControlStates() {
      const isMoveOut = mode === 'flat_rate' && service === 'move_out';

      if (flatPanel) flatPanel.hidden = mode !== 'flat_rate';
      if (hourlyPanel) hourlyPanel.hidden = mode !== 'hourly';
      if (hoursDisplay) hoursDisplay.textContent = `${hours} Hours`;
      if (moveOutFreqNote) moveOutFreqNote.hidden = !isMoveOut;
      if (moveOutFreeBanner) moveOutFreeBanner.hidden = !isMoveOut;

      root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]').forEach((btn) => {
        const active = btn.dataset.modeBtn === mode;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('bg-eucalyptus', active);
        btn.classList.toggle('text-linen', active);
        btn.classList.toggle('shadow-2xs', active);
        btn.classList.toggle('text-spruce', !active);
      });

      root.querySelectorAll<HTMLButtonElement>('[data-service-btn]').forEach((btn) => {
        const active = btn.dataset.serviceBtn === service;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('border-eucalyptus', active);
        btn.classList.toggle('bg-eucalyptus', active);
        btn.classList.toggle('text-linen', active);
        btn.classList.toggle('border-mist/35', !active);
        btn.classList.toggle('bg-linen', !active);
        btn.classList.toggle('text-spruce', !active);
        const tag = btn.querySelector<HTMLElement>('[data-service-tag]');
        if (tag) {
          tag.classList.toggle('text-linen/90', active);
          tag.classList.toggle('text-spruce/75', !active);
        }
      });

      root.querySelectorAll<HTMLButtonElement>('[data-bed-btn]').forEach((btn) => {
        const active = Number(btn.dataset.bedBtn) === bedrooms;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('border-eucalyptus', active);
        btn.classList.toggle('bg-eucalyptus', active);
        btn.classList.toggle('text-linen', active);
        btn.classList.toggle('border-mist/35', !active);
        btn.classList.toggle('bg-linen', !active);
        btn.classList.toggle('text-spruce', !active);
      });

      root.querySelectorAll<HTMLButtonElement>('[data-bath-btn]').forEach((btn) => {
        const active = Number(btn.dataset.bathBtn) === bathrooms;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('border-eucalyptus', active);
        btn.classList.toggle('bg-eucalyptus', active);
        btn.classList.toggle('text-linen', active);
        btn.classList.toggle('border-mist/35', !active);
        btn.classList.toggle('bg-linen', !active);
        btn.classList.toggle('text-spruce', !active);
      });

      root.querySelectorAll<HTMLButtonElement>('[data-cleaner-btn]').forEach((btn) => {
        const active = Number(btn.dataset.cleanerBtn) === cleaners;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('border-eucalyptus', active);
        btn.classList.toggle('bg-eucalyptus', active);
        btn.classList.toggle('text-linen', active);
        btn.classList.toggle('border-mist/35', !active);
        btn.classList.toggle('bg-linen', !active);
        btn.classList.toggle('text-spruce', !active);
      });

      root.querySelectorAll<HTMLButtonElement>('[data-freq-btn]').forEach((btn) => {
        const id = btn.dataset.freqBtn as Frequency;
        const disabled = isMoveOut && id !== 'one_time';
        const active = isMoveOut ? id === 'one_time' : id === frequency;
        btn.disabled = disabled;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('border-eucalyptus', active);
        btn.classList.toggle('bg-eucalyptus', active);
        btn.classList.toggle('text-linen', active);
        btn.classList.toggle('font-semibold', active);
        btn.classList.toggle('border-mist/35', !active);
        btn.classList.toggle('bg-linen', !active);
        btn.classList.toggle('text-spruce', !active);
        btn.classList.toggle('opacity-45', disabled);
        btn.classList.toggle('cursor-not-allowed', disabled);
        btn.classList.toggle('cursor-pointer', !disabled);
      });

      root.querySelectorAll<HTMLInputElement>('[data-addon-checkbox]').forEach((cb) => {
        const addonId = cb.dataset.addonCheckbox as AddonId;
        const lockedFree = isMoveOut && MOVE_OUT_FREE_IDS.includes(addonId);
        cb.disabled = lockedFree;
        cb.checked = lockedFree || userAddons.has(addonId);

        const card = root.querySelector<HTMLElement>(`[data-addon-card="${addonId}"]`);
        if (card) {
          card.classList.toggle('border-eucalyptus', cb.checked);
          card.classList.toggle('bg-eucalyptus/10', cb.checked);
          card.classList.toggle('font-medium', cb.checked);
          card.classList.toggle('border-mist/35', !cb.checked);
          card.classList.toggle('bg-linen', !cb.checked);
        }

        const pill = root.querySelector<HTMLElement>(`[data-addon-price-pill="${addonId}"]`);
        if (pill) {
          const regPrice = pill.dataset.regularPrice || '45';
          pill.textContent = lockedFree ? 'Included FREE' : `+$${regPrice}`;
          pill.classList.toggle('bg-eucalyptus', lockedFree);
          pill.classList.toggle('text-linen', lockedFree);
          pill.classList.toggle('bg-card', !lockedFree);
          pill.classList.toggle('text-spruce/85', !lockedFree);
        }
      });
    }

    function updateSummaryUI() {
      const quote = calculateQuote(buildCurrentQuoteInput());
      const postalCheck = postalCode ? lookupPostalCode(postalCode) : null;

      if (finalEl) finalEl.textContent = `$${quote.finalPreTaxCad}`;
      if (gstEl) {
        gstEl.textContent = `+ 5% AB GST where applicable (est. $${quote.estimatedGstCad.toFixed(2)} GST)`;
      }

      if (promoBadgeEl) {
        promoBadgeEl.hidden = quote.promo.discountCad <= 0;
        promoBadgeEl.textContent = quote.promo.badge;
      }

      if (savingsPillEl) {
        savingsPillEl.hidden = quote.competitorSavingsCad <= 0;
        savingsPillEl.textContent = `Saves $${quote.competitorSavingsCad} CAD vs. $${quote.competitorMedianCad} Edmonton 30-company median`;
      }

      if (freeBundleEl) {
        freeBundleEl.hidden = quote.includedFreeSavingsCad <= 0;
      }

      if (serviceLabelEl) {
        serviceLabelEl.textContent =
          quote.mode === 'hourly'
            ? `${hours} hrs × ${cleaners} ${cleaners === 1 ? 'Specialist' : 'Specialists'} ($48/hr)`
            : `${quote.serviceTitle} (${bedrooms} Bed / ${bathrooms} Bath)`;
      }
      if (basePriceEl) basePriceEl.textContent = `$${quote.basePriceCad}`;

      if (rowBaths) rowBaths.hidden = quote.extraBathroomFeeCad <= 0;
      if (lineBaths) lineBaths.textContent = `+$${quote.extraBathroomFeeCad}`;

      if (rowAddons) rowAddons.hidden = quote.addonsTotalCad <= 0;
      if (lineAddons) lineAddons.textContent = `+$${quote.addonsTotalCad}`;

      if (lineTravelLabel) {
        lineTravelLabel.textContent =
          postalCheck && postalCheck.valid
            ? `Travel Zone (${postalCheck.municipality})`
            : 'Greater Edmonton Travel Zone';
      }
      if (lineTravel) {
        lineTravel.textContent =
          quote.travelFeeCad === 0 ? '$0 Travel' : `+$${quote.travelFeeCad}`;
      }

      if (rowFreq) rowFreq.hidden = quote.frequencyDiscountCad <= 0;
      if (lineFreqLabel) {
        lineFreqLabel.textContent = `Recurring Plan Discount (${quote.frequencyDiscountPct}%)`;
      }
      if (lineFreq) lineFreq.textContent = `−$${quote.frequencyDiscountCad}`;

      if (rowPromo) rowPromo.hidden = quote.promo.discountCad <= 0;
      if (linePromo) linePromo.textContent = `−$${quote.promo.discountCad}`;

      const smsHref = buildSmsPrefillHref(
        quote,
        postalCheck?.valid ? postalCheck.normalizedFsa : postalCode,
        nameInput?.value,
      );
      if (smsPrefillLink) smsPrefillLink.href = smsHref;
      document.querySelectorAll<HTMLAnchorElement>('[data-sticky-sms]').forEach((el) => {
        el.href = smsHref;
      });
    }

    function updatePostalUI() {
      postalCode = (postalInput?.value || '').trim().toUpperCase();
      if (!postalBadge) return;

      if (!postalCode) {
        postalBadge.className =
          'flex min-h-[48px] items-center rounded-2xl border border-mist/30 bg-linen/80 px-4 py-2.5 text-xs sm:text-sm text-spruce/80';
        postalBadge.textContent =
          'Enter your 3-character FSA (T5*, T6*, T8N, T8A, T7X, T9E…) to verify $0 travel zone.';
        return;
      }

      const cleaned = postalCode.replace(/[\s-]+/g, '');
      if (cleaned.length < 3) {
        postalBadge.className =
          'flex min-h-[48px] items-center rounded-2xl border border-mist/30 bg-linen/80 px-4 py-2.5 text-xs sm:text-sm text-spruce/80';
        postalBadge.textContent = 'Keep typing your 3-character Edmonton FSA (e.g. T5K, T6W, T8N)…';
        return;
      }

      const res = lookupPostalCode(postalCode);
      if (res.valid && res.travelFeeCad === 0) {
        postalBadge.className =
          'flex min-h-[48px] items-center rounded-2xl border border-eucalyptus/45 bg-eucalyptus/12 px-4 py-2.5 text-xs sm:text-sm font-semibold text-spruce';
        postalBadge.textContent = `✓ ${res.areaName} — $0 Travel`;
      } else if (res.valid && res.travelFeeCad > 0) {
        postalBadge.className =
          'flex min-h-[48px] items-center rounded-2xl border border-brass/60 bg-brass/18 px-4 py-2.5 text-xs sm:text-sm font-semibold text-spruce';
        postalBadge.textContent = `✓ ${res.areaName} — +$${res.travelFeeCad} Greater Edmonton Ring`;
      } else {
        postalBadge.className =
          'flex min-h-[48px] items-center rounded-2xl border border-brass bg-brass/20 px-4 py-2.5 text-xs sm:text-sm font-medium text-spruce';
        postalBadge.textContent = res.message;
      }
    }

    // Bind Step 1 & Step 2 listeners
    postalInput?.addEventListener('input', () => {
      updatePostalUI();
      updateSummaryUI();
    });

    nameInput?.addEventListener('input', () => {
      updateSummaryUI();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        mode = btn.dataset.modeBtn === 'hourly' ? 'hourly' : 'flat_rate';
        if (mode === 'flat_rate' && service === 'hourly') service = 'move_out';
        syncControlStates();
        updateSummaryUI();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-service-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        service = (btn.dataset.serviceBtn as ServiceId) || 'move_out';
        syncControlStates();
        updateSummaryUI();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-bed-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        bedrooms = Number(btn.dataset.bedBtn) || 2;
        syncControlStates();
        updateSummaryUI();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-bath-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        bathrooms = Number(btn.dataset.bathBtn) || 2;
        syncControlStates();
        updateSummaryUI();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-hours-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const delta = Number(btn.dataset.hoursStep) || 0;
        hours = Math.min(10, Math.max(3, hours + delta));
        syncControlStates();
        updateSummaryUI();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-cleaner-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        cleaners = Number(btn.dataset.cleanerBtn) || 1;
        syncControlStates();
        updateSummaryUI();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-freq-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        frequency = (btn.dataset.freqBtn as Frequency) || 'one_time';
        syncControlStates();
        updateSummaryUI();
      });
    });

    root.querySelectorAll<HTMLInputElement>('[data-addon-checkbox]').forEach((cb) => {
      cb.addEventListener('change', () => {
        const addonId = cb.dataset.addonCheckbox as AddonId;
        if (cb.disabled) return;
        if (cb.checked) {
          userAddons.add(addonId);
        } else {
          userAddons.delete(addonId);
        }
        syncControlStates();
        updateSummaryUI();
      });
    });

    // Snap & Lock Canvas photo upload
    snapInput?.addEventListener('change', async () => {
      const files = Array.from(snapInput.files || []);
      if (!files.length) {
        snapPhotos = [];
        if (snapStatus) snapStatus.textContent = '';
        return;
      }

      const selected = files.slice(0, 2);
      if (snapStatus) {
        snapStatus.textContent = 'Compressing room photo(s) locally in your browser…';
      }

      try {
        const compressed = await Promise.all(selected.map((f) => compressImageFile(f)));
        snapPhotos = compressed;
        if (snapStatus) {
          const totalKb = Math.round(
            compressed.reduce((acc, p) => acc + (p.base64Data.length * 3) / 4, 0) / 1024,
          );
          const extraNote = files.length > 2 ? ' (attached first 2 photos — max 2)' : '';
          snapStatus.textContent = `✓ Ready: ${compressed.map((c) => c.filename).join(', ')} (${totalKb} KB optimized)${extraNote}`;
        }
      } catch {
        snapPhotos = [];
        if (snapStatus) {
          snapStatus.textContent =
            'Could not compress photo — you can still submit your quote or text photos to +1 (780) 710-1503.';
        }
      }
    });

    caslCheckbox?.addEventListener('change', () => {
      if (caslCheckbox.checked && caslWrapper) {
        caslWrapper.classList.remove('border-brass', 'bg-brass/15');
      }
    });

    function showError(msg: string) {
      if (!errorBox) return;
      errorBox.textContent = msg;
      errorBox.hidden = false;
    }

    // Form Submission Gate
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorBox) errorBox.hidden = true;
      if (successBox) successBox.hidden = true;

      const currentPostal = (postalInput?.value || '').trim();
      const postalCheck = lookupPostalCode(currentPostal);
      if (!postalCheck.valid) {
        showError(
          postalCheck.message ||
            'Please enter a valid Greater Edmonton postal code (e.g. T5K, T6W, T8N) in Step 1.',
        );
        postalInput?.focus();
        return;
      }

      const nameVal = (nameInput?.value || '').trim();
      if (!nameVal) {
        showError('Please enter your full name so we can prepare your quote.');
        nameInput?.focus();
        return;
      }

      const phoneVal = (phoneInput?.value || '').trim();
      const digits = phoneVal.replace(/\D+/g, '');
      if (digits.length < 10 || digits.length > 15) {
        showError('Please enter a valid 10-digit mobile phone number (e.g. 780-710-1503).');
        phoneInput?.focus();
        return;
      }

      const emailVal = (emailInput?.value || '').trim();
      if (emailVal && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
        showError('Please enter a valid email address or leave the optional email field blank.');
        emailInput?.focus();
        return;
      }

      // Mandatory CASL SMS consent verification
      if (!caslCheckbox?.checked) {
        if (caslWrapper) {
          caslWrapper.classList.add('border-brass', 'bg-brass/15');
        }
        showError(
          'Explicit CASL SMS consent is required: please check the SMS consent box above so our Edmonton team can text your confirmed quote (or tap "1-Tap Pre-Filled SMS").',
        );
        caslCheckbox?.focus();
        return;
      }

      const fbclid = urlParams.get('fbclid') || undefined;
      const fbp = readCookie('_fbp');
      const fbc = readCookie('_fbc') || (fbclid ? `fb.1.${Date.now()}.${fbclid}` : undefined);

      const attribution: AttributionData = {
        fbclid,
        fbp,
        fbc,
        gclid: urlParams.get('gclid') || undefined,
        utmSource: urlParams.get('utm_source') || undefined,
        utmMedium: urlParams.get('utm_medium') || undefined,
        utmCampaign: urlParams.get('utm_campaign') || undefined,
        landingPath: window.location.pathname,
        eventId: generateEventId(),
      };

      const quoteInput = buildCurrentQuoteInput();
      const payload: LeadSubmissionPayload = {
        name: nameVal,
        phone: phoneVal,
        ...(emailVal ? { email: emailVal } : {}),
        postalCode: currentPostal.toUpperCase(),
        ...(dateInput?.value ? { preferredDate: dateInput.value } : {}),
        hasPets: Boolean(petsInput?.checked),
        ...(notesInput?.value.trim() ? { notes: notesInput.value.trim() } : {}),
        caslSmsConsent: true,
        honeypot: honeypotInput?.value || '',
        quoteInput,
        ...(snapPhotos.length > 0 ? { snapPhotos } : {}),
        attribution,
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Reserving Your Rate…';
      }

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });

        const contentType = res.headers.get('content-type') || '';
        if (contentType.includes('application/json')) {
          const result = (await res.json()) as LeadSubmissionResult;
          if (!res.ok || !result.ok) {
            showError(
              result.error || 'Could not submit your request right now. Please tap 1-Tap Pre-Filled SMS below.',
            );
            return;
          }

          if (successDetail) {
            successDetail.textContent = `Reference #${result.leadId} for ${result.areaName}: $${result.finalPreTaxCad} CAD pre-tax (+ 5% AB GST where applicable). $0 due today — our Edmonton team will text ${phoneVal} shortly to confirm your arrival window.`;
          }
          if (successSms && result.smsPrefillHref) {
            successSms.href = result.smsPrefillHref;
          }
          if (successBox) {
            successBox.hidden = false;
            successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        } else {
          // Local static preview fallback without Cloudflare Functions runtime
          const localQuote = calculateQuote(quoteInput);
          const fallbackHref = buildSmsPrefillHref(localQuote, postalCheck.normalizedFsa, nameVal);
          if (successDetail) {
            successDetail.textContent = `Estimated Quote for ${postalCheck.areaName}: $${localQuote.finalPreTaxCad} CAD pre-tax (+ 5% AB GST where applicable) with $0 upfront deposit. Tap below to send directly to our Edmonton dispatch via SMS.`;
          }
          if (successSms) successSms.href = fallbackHref;
          if (successBox) successBox.hidden = false;
        }
      } catch {
        showError(
          'Network connection interrupted — tap "1-Tap Pre-Filled SMS" below to text your locked quote directly to +1 (780) 710-1503.',
        );
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Lock In My Rate ($0 Upfront)';
        }
      }
    });

    // Hydrate initial URL promo override if present
    syncControlStates();
    updateSummaryUI();
  });
</script>
