            <div class="flex items-center justify-between gap-3">
              <span data-line-travel-label class="text-linen/80">Greater Edmonton Travel Zone</span>
              <span data-line-travel class="font-semibold text-linen">
                {initialQuote.travelFeeCad === 0 ? '$0 Travel' : `+$${initialQuote.travelFeeCad}`}
