---
import siteCopy from '../data/site_copy.json';
import strategy from '../data/strategy.json';
import MoveOutReceiptModal from './MoveOutReceiptModal.astro';

interface Props {
  showComparison?: boolean;
  includeModal?: boolean;
}

const { showComparison = true, includeModal = true } = Astro.props;
const pillars = siteCopy.home.trustPillars;
const comparisonRows = strategy.pricing.competitorComparison;
---

<section class="py-16 sm:py-20 border-y border-mist/25 bg-card/60">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 rounded-full border border-brass/45 bg-brass/15 px-3.5 py-1 text-xs font-semibold tracking-wider uppercase text-spruce">
        <span class="h-1.5 w-1.5 rounded-full bg-brass" aria-hidden="true"></span>
        The LevelUp Risk-Reversal Protocol
      </span>
      <h2 class="mt-3 font-serif text-3xl sm:text-4xl font-semibold text-spruce">
        Zero Upfront Deposit. Verified Room-by-Room Before You Pay.
      </h2>
      <p class="mt-3 text-base sm:text-lg leading-relaxed text-spruce/80">
        Instead of vague promises, every Edmonton clean follows a transparent, verifiable walkthrough standard backed by local credentials and botanical surface care.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {pillars.map((pillar, idx) => (
        <article class="flex flex-col justify-between rounded-2xl border border-mist/30 bg-linen p-5 shadow-2xs">
          <div>
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-eucalyptus/15 font-mono text-xs font-bold text-eucalyptus">
              0{idx + 1}
            </span>
            <h3 class="mt-3 font-serif text-lg font-semibold leading-snug text-spruce">
              {pillar.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-spruce/80">
              {pillar.detail}
            </p>
          </div>

          {pillar.id === 'landlord-receipt' && (
            <div class="mt-4 pt-2">
              <button
                type="button"
                data-open-receipt-modal
                class="inline-flex min-h-[44px] items-center gap-1.5 text-xs font-semibold text-eucalyptus underline decoration-eucalyptus/50 underline-offset-4 hover:text-eucalyptus-hover cursor-pointer"
              >
                <span>Preview Sample RTA Receipt →</span>
              </button>
            </div>
          )}
        </article>
      ))}
    </div>

    {showComparison && (
      <div class="mt-14">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h3 class="font-serif text-2xl sm:text-3xl font-semibold text-spruce">
              How LevelUp Compares Across 30 Edmonton Cleaning Companies
            </h3>
            <p class="mt-1 text-sm text-spruce/80">
              Benchmarked across {strategy.pricing.edmontonMarketBenchmarks.dataPoints} verified Greater Edmonton residential pricing data points.
            </p>
          </div>
          <p class="text-xs font-semibold text-spruce/75">
            All CAD prices pre-tax (+ 5% AB GST where applicable)
          </p>
        </div>

        <div class="mt-6 grid gap-4 md:hidden">
          {comparisonRows.map((row) => (
            <div class="rounded-2xl border border-mist/35 bg-linen p-4 space-y-2.5">
              <p class="font-serif text-base font-semibold text-spruce">{row.feature}</p>
              <div class="rounded-xl bg-eucalyptus/10 border border-eucalyptus/30 p-3 text-xs">
                <span class="block font-bold uppercase tracking-wider text-eucalyptus">LevelUp Cleaning</span>
                <span class="mt-0.5 block font-medium text-spruce">{row.levelup}</span>
              </div>
              <div class="grid grid-cols-1 gap-1.5 text-xs text-spruce/80 pl-1">
                <p><span class="font-semibold text-spruce">Edmonton Median:</span> {row.edmontonMedian}</p>
                <p><span class="font-semibold text-spruce">Franchise Chains:</span> {row.franchiseChains}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-6 hidden md:block overflow-x-auto rounded-3xl border border-mist/35 bg-linen shadow-xs">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b border-mist/30 bg-spruce text-linen">
                <th scope="col" class="py-4 px-5 font-serif font-semibold">Standard</th>
                <th scope="col" class="py-4 px-5 font-serif font-semibold bg-eucalyptus text-linen">LevelUp Cleaning</th>
                <th scope="col" class="py-4 px-5 font-serif font-semibold">Edmonton Median (30 Co.)</th>
                <th scope="col" class="py-4 px-5 font-serif font-semibold">Franchise Chains</th>
                <th scope="col" class="py-4 px-5 font-serif font-semibold">Unvetted Classifieds</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-mist/25">
              {comparisonRows.map((row) => (
                <tr class="align-top">
                  <th scope="row" class="py-4 px-5 font-semibold text-spruce w-1/5">{row.feature}</th>
                  <td class="py-4 px-5 bg-eucalyptus/8 font-medium text-spruce w-1/4">
                    <span class="text-eucalyptus font-bold mr-1" aria-hidden="true">✓</span>
                    {row.levelup}
                  </td>
                  <td class="py-4 px-5 text-spruce/80">{row.edmontonMedian}</td>
                  <td class="py-4 px-5 text-spruce/80">{row.franchiseChains}</td>
                  <td class="py-4 px-5 text-spruce/75">{row.kijijiCleaners}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>

  {includeModal && <MoveOutReceiptModal />}
</section>
