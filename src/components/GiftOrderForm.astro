---
import siteContext from '../data/site_context_lock.json';

const { brand } = siteContext;
---

<section id="gift-order-form" class="py-16 sm:py-20 border-t border-mist/25 bg-card/55">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <span class="inline-flex items-center gap-2 rounded-full border border-brass/50 bg-brass/18 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-spruce">
        Same-Day Digital Delivery • Alberta Zero-Expiry Credit
      </span>
      <h2 class="mt-3 font-serif text-3xl sm:text-4xl font-semibold text-spruce">
        Order Your Gift a Clean Certificate Online
      </h2>
      <p class="mt-2 text-sm sm:text-base text-spruce/80">
        Choose $150, $250, $350, or any custom amount ($50+). We confirm via Interac e-Transfer or card and deliver your custom eucalyptus-linen digital certificate the same day.
      </p>
    </div>

    <form
      data-gift-form
      novalidate
      class="rounded-3xl border border-mist/40 bg-linen p-6 sm:p-8 shadow-md space-y-6"
    >
      <div class="hidden" aria-hidden="true">
        <label>
          Website
          <input type="text" name="honeypot" tabindex="-1" autocomplete="off" data-gift-honeypot />
        </label>
      </div>

      <div class="space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-spruce/75">
          1. Select Gift Certificate Amount (CAD) <span class="text-eucalyptus">*</span>
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" role="group" aria-label="Gift amount presets">
          {[150, 250, 350].map((amt) => (
            <button
              type="button"
              data-gift-preset={String(amt)}
              aria-pressed={amt === 250 ? 'true' : 'false'}
              class:list={[
                'min-h-[50px] rounded-2xl border px-4 py-2.5 text-sm font-semibold transition cursor-pointer',
                amt === 250
                  ? 'border-eucalyptus bg-eucalyptus text-linen shadow-xs'
                  : 'border-mist/40 bg-card text-spruce hover:border-eucalyptus',
              ]}
            >
              ${amt} CAD
            </button>
          ))}
          <button
            type="button"
            data-gift-preset="custom"
            aria-pressed="false"
            class="min-h-[50px] rounded-2xl border border-mist/40 bg-card px-4 py-2.5 text-sm font-semibold text-spruce transition hover:border-eucalyptus cursor-pointer"
          >
            Custom ($50+)
          </button>
        </div>

        <div data-gift-custom-wrap hidden class="pt-1">
          <label for="gift-custom-amount" class="block text-xs font-semibold text-spruce mb-1.5">
            Custom Certificate Amount ($50 CAD minimum)
          </label>
          <input
            id="gift-custom-amount"
            type="number"
            min="50"
            max="2000"
            step="5"
            value="250"
            data-gift-custom-input
            class="w-full sm:w-56 min-h-[46px] rounded-xl border border-mist/45 bg-card px-3.5 py-2.5 text-base font-semibold text-spruce focus:border-eucalyptus"
          />
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="gift-recipient" class="block text-xs font-semibold text-spruce mb-1.5">
            Recipient Name <span class="text-eucalyptus">*</span>
          </label>
          <input
            id="gift-recipient"
            type="text"
            required
            placeholder="e.g. Sarah &amp; Mark"
            data-gift-recipient
            class="w-full min-h-[46px] rounded-xl border border-mist/45 bg-card px-3.5 py-2.5 text-sm text-spruce placeholder:text-spruce/45 focus:border-eucalyptus"
          />
        </div>

        <div>
          <label for="gift-delivery" class="block text-xs font-semibold text-spruce mb-1.5">
            Delivery Format
          </label>
          <select
            id="gift-delivery"
            data-gift-delivery
            class="w-full min-h-[46px] rounded-xl border border-mist/45 bg-card px-3.5 py-2.5 text-sm text-spruce focus:border-eucalyptus"
          >
            <option value="printable_pdf">Printable Digital PDF (Email to Me)</option>
            <option value="email">Direct Email Certificate</option>
            <option value="sms">Instant SMS Gift Card Link</option>
          </select>
        </div>

        <div class="sm:col-span-2">
          <label for="gift-message" class="block text-xs font-semibold text-spruce mb-1.5">
            Personal Holiday / Gift Note <span class="font-normal text-spruce/70">(Optional — printed on the certificate)</span>
          </label>
          <textarea
            id="gift-message"
            rows="2"
            placeholder="Enjoy a calm, spotless weekend on us! Happy Holidays!"
            data-gift-message
            class="w-full rounded-xl border border-mist/45 bg-card px-3.5 py-2.5 text-sm text-spruce placeholder:text-spruce/45 focus:border-eucalyptus"
          ></textarea>
        </div>
      </div>

      <div class="border-t border-mist/25 pt-5 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="gift-buyer-name" class="block text-xs font-semibold text-spruce mb-1.5">
            Your Name <span class="text-eucalyptus">*</span>
          </label>
          <input
            id="gift-buyer-name"
            type="text"
            required
            autocomplete="name"
            placeholder="Jordan Taylor"
            data-gift-name
            class="w-full min-h-[46px] rounded-xl border border-mist/45 bg-card px-3.5 py-2.5 text-sm text-spruce placeholder:text-spruce/45 focus:border-eucalyptus"
          />
        </div>

        <div>
          <label for="gift-buyer-phone" class="block text-xs font-semibold text-spruce mb-1.5">
            Your Mobile Number <span class="text-eucalyptus">*</span>
          </label>
          <input
            id="gift-buyer-phone"
            type="tel"
            required
            autocomplete="tel"
            placeholder="(780) 710-1503"
            data-gift-phone
            class="w-full min-h-[46px] rounded-xl border border-mist/45 bg-card px-3.5 py-2.5 text-sm text-spruce placeholder:text-spruce/45 focus:border-eucalyptus"
          />
        </div>

        <div class="sm:col-span-2">
          <label for="gift-buyer-email" class="block text-xs font-semibold text-spruce mb-1.5">
            Your Email <span class="font-normal text-spruce/70">(Recommended — for same-day PDF delivery)</span>
          </label>
          <input
            id="gift-buyer-email"
            type="email"
            autocomplete="email"
            placeholder="you@example.ca"
            data-gift-email
            class="w-full min-h-[46px] rounded-xl border border-mist/45 bg-card px-3.5 py-2.5 text-sm text-spruce placeholder:text-spruce/45 focus:border-eucalyptus"
          />
        </div>
      </div>

      <label
        data-gift-casl-wrap
        class="flex min-h-[48px] items-start gap-3 rounded-2xl border border-mist/45 bg-card p-3.5 text-xs leading-relaxed text-spruce cursor-pointer"
      >
        <input
          type="checkbox"
          data-gift-casl
          class="mt-0.5 h-4 w-4 shrink-0 rounded accent-eucalyptus"
        />
        <span>
          <strong class="font-semibold">CASL SMS Consent (Required):</strong> I consent to receive text messages from LevelUp Cleaning (+1 (780) 710-1503) to confirm payment and deliver my digital gift certificate. Reply STOP anytime. <a href="/privacy" class="underline font-semibold hover:text-eucalyptus">Privacy &amp; CASL Terms</a>.
        </span>
      </label>

      <div
        data-gift-error
        role="alert"
        hidden
        class="rounded-2xl border border-brass bg-brass/20 px-4 py-3 text-xs sm:text-sm font-semibold text-spruce"
      ></div>

      <div
        data-gift-success
        role="status"
        hidden
        class="rounded-2xl border border-eucalyptus bg-eucalyptus/12 p-5 space-y-2 text-sm text-spruce"
      >
        <p class="font-serif text-xl font-semibold">✓ Gift Certificate Order Received!</p>
        <p data-gift-success-detail class="text-xs sm:text-sm text-spruce/90"></p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3">
        <button
          type="submit"
          data-gift-submit
          class="inline-flex min-h-[50px] flex-1 items-center justify-center rounded-full bg-eucalyptus px-6 py-3 text-sm font-semibold text-linen shadow-sm transition hover:bg-eucalyptus-hover cursor-pointer"
        >
          Order $250 Gift Certificate →
        </button>
        <a
          href={`sms:${brand.phoneE164}?&body=${encodeURIComponent("Hi LevelUp Cleaning! I'd like to order a Gift a Clean certificate.")}`}
          class="inline-flex min-h-[50px] items-center justify-center rounded-full border border-spruce/30 bg-card px-5 py-3 text-xs sm:text-sm font-semibold text-spruce transition hover:border-eucalyptus"
        >
          Or Order via SMS
        </a>
      </div>
    </form>
  </div>
</section>

<script>
  import type {
    GiftCertificateDetails,
    LeadSubmissionPayload,
    LeadSubmissionResult,
  } from '../types/contracts';
  import { trackClientLeadConversion } from '../lib/tracking';

  document.querySelectorAll<HTMLFormElement>('[data-gift-form]').forEach((form) => {
    let amountCad = 250;
    let isCustom = false;

    const presetBtns = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-gift-preset]'));
    const customWrap = form.querySelector<HTMLElement>('[data-gift-custom-wrap]');
    const customInput = form.querySelector<HTMLInputElement>('[data-gift-custom-input]');
    const recipientEl = form.querySelector<HTMLInputElement>('[data-gift-recipient]');
    const deliveryEl = form.querySelector<HTMLSelectElement>('[data-gift-delivery]');
    const msgEl = form.querySelector<HTMLTextAreaElement>('[data-gift-message]');
    const nameEl = form.querySelector<HTMLInputElement>('[data-gift-name]');
    const phoneEl = form.querySelector<HTMLInputElement>('[data-gift-phone]');
    const emailEl = form.querySelector<HTMLInputElement>('[data-gift-email]');
    const honeypotEl = form.querySelector<HTMLInputElement>('[data-gift-honeypot]');
    const caslEl = form.querySelector<HTMLInputElement>('[data-gift-casl]');
    const caslWrap = form.querySelector<HTMLElement>('[data-gift-casl-wrap]');
    const errorEl = form.querySelector<HTMLElement>('[data-gift-error]');
    const successEl = form.querySelector<HTMLElement>('[data-gift-success]');
    const successDetail = form.querySelector<HTMLElement>('[data-gift-success-detail]');
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-gift-submit]');

    const syncAmountUI = () => {
      presetBtns.forEach((btn) => {
        const val = btn.dataset.giftPreset;
        const active = isCustom ? val === 'custom' : Number(val) === amountCad;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('border-eucalyptus', active);
        btn.classList.toggle('bg-eucalyptus', active);
        btn.classList.toggle('text-linen', active);
        btn.classList.toggle('shadow-xs', active);
        btn.classList.toggle('border-mist/40', !active);
        btn.classList.toggle('bg-card', !active);
        btn.classList.toggle('text-spruce', !active);
      });
      if (customWrap) customWrap.hidden = !isCustom;
      if (submitBtn && !submitBtn.disabled) {
        submitBtn.textContent = `Order $${amountCad} Gift Certificate →`;
      }
    };

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.dataset.giftPreset;
        if (val === 'custom') {
          isCustom = true;
          amountCad = Math.max(50, Math.round(Number(customInput?.value || '250') || 250));
          syncAmountUI();
          customInput?.focus();
        } else {
          isCustom = false;
          amountCad = Number(val) || 250;
          if (customInput) customInput.value = String(amountCad);
          syncAmountUI();
        }
      });
    });

    customInput?.addEventListener('input', () => {
      const parsed = Math.round(Number(customInput.value) || 0);
      if (parsed >= 50) {
        amountCad = parsed;
        if (submitBtn && !submitBtn.disabled) {
          submitBtn.textContent = `Order $${amountCad} Gift Certificate →`;
        }
      }
    });

    window.addEventListener('levelup:gift-tier', ((ev: CustomEvent<{ amountCad?: number }>) => {
      const incoming = Number(ev.detail?.amountCad || '250');
      if (incoming >= 50) {
        isCustom = ![150, 250, 350].includes(incoming);
        amountCad = incoming;
        if (customInput) customInput.value = String(incoming);
        syncAmountUI();
      }
      document.getElementById('gift-order-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }) as EventListener);

    caslEl?.addEventListener('change', () => {
      if (caslEl.checked && caslWrap) {
        caslWrap.classList.remove('border-brass', 'bg-brass/15');
      }
    });

    const showErr = (msg: string) => {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorEl) errorEl.hidden = true;
      if (successEl) successEl.hidden = true;

      const finalAmount = isCustom ? Math.round(Number(customInput?.value || '0')) : amountCad;
      const recipientName = (recipientEl?.value || '').trim();
      const buyerName = (nameEl?.value || '').trim();
      const phoneVal = (phoneEl?.value || '').trim();
      const digits = phoneVal.replace(/\D+/g, '');
      const emailVal = (emailEl?.value || '').trim();

      if (!Number.isFinite(finalAmount) || finalAmount < 50) {
        showErr('Gift certificate amount must be at least $50 CAD.');
        customInput?.focus();
        return;
      }
      if (!recipientName) {
        showErr('Please enter the recipient name for the certificate.');
        recipientEl?.focus();
        return;
      }
      if (!buyerName) {
        showErr('Please enter your name.');
        nameEl?.focus();
        return;
      }
      if (digits.length < 10 || digits.length > 15) {
        showErr('Please enter a valid 10-digit mobile number.');
        phoneEl?.focus();
        return;
      }
      if (!caslEl?.checked) {
        caslWrap?.classList.add('border-brass', 'bg-brass/15');
        showErr('Please check the CASL SMS consent box so we can send your certificate confirmation.');
        caslEl?.focus();
        return;
      }

      const giftDetails: GiftCertificateDetails = {
        amountCad: finalAmount,
        recipientName,
        ...(msgEl?.value.trim() ? { personalMessage: msgEl.value.trim() } : {}),
        deliveryMethod:
          (deliveryEl?.value as GiftCertificateDetails['deliveryMethod']) || 'printable_pdf',
      };

      const payload: LeadSubmissionPayload = {
        leadType: 'gift_certificate',
        name: buyerName,
        phone: phoneVal,
        ...(emailVal ? { email: emailVal } : {}),
        postalCode: 'T5J',
        caslSmsConsent: true,
        honeypot: honeypotEl?.value || '',
        quoteInput: {
          mode: 'flat_rate',
          service: 'regular',
          bedrooms: 2,
          bathrooms: 1,
          frequency: 'one_time',
          postalCode: 'T5J',
        },
        giftDetails,
        attribution: {
          landingPath: window.location.pathname,
        },
      };

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Gift Order…';
      }

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const ct = res.headers.get('content-type') || '';
        if (ct.includes('application/json')) {
          const result = (await res.json()) as LeadSubmissionResult;
          if (!res.ok || !result.ok) {
            showErr(result.error || 'Could not process gift order right now. Please text +1 (780) 710-1503.');
            return;
          }
          trackClientLeadConversion({
            leadId: result.leadId,
            valueCad: finalAmount,
            service: 'gift_certificate',
            email: emailVal || undefined,
            phone: phoneVal,
          });
          if (successDetail) {
            successDetail.textContent = `Order #${result.leadId} for a $${finalAmount} CAD certificate for ${recipientName} is logged! We will text ${phoneVal} shortly with Interac e-Transfer / card details and send your same-day digital certificate.`;
          }
          if (successEl) successEl.hidden = false;
        } else {
          if (successDetail) {
            successDetail.textContent = `Gift certificate request for $${finalAmount} CAD (${recipientName}) prepared. Text +1 (780) 710-1503 for immediate delivery.`;
          }
          if (successEl) successEl.hidden = false;
        }
      } catch {
        showErr('Network interrupted. Text +1 (780) 710-1503 to complete your gift certificate.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = `Order $${finalAmount} Gift Certificate →`;
        }
      }
    });
  });
</script>
